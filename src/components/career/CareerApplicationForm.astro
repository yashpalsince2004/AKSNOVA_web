---
// CareerApplicationForm.astro
// Clean, aesthetic, and minimal application form for Careers at AKSNOVA
import { withBase } from "@/lib/paths";

const softwareLottieUrl = withBase("/animations/software-development.lottie?v=1");
const softwareJsonUrl = withBase("/animations/software-development.json?v=1");
const wasmUrl = withBase("/animations/dotlottie-player.wasm");
---

<section id="career-apply" class="relative py-12 md:py-16 scroll-mt-20">
  <!-- Soft subtle ambient background glow -->
  <div class="pointer-events-none absolute inset-0 -z-10 flex items-center justify-center overflow-hidden">
    <div class="h-96 w-full max-w-5xl rounded-full bg-gradient-to-tr from-brand/5 via-primary/5 to-transparent blur-3xl opacity-70"></div>
  </div>

  <div class="mx-auto max-w-7xl">
    <!-- Main 2-Column Grid: Form Card on Left, Software Dev Animation on Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 items-center">
      <!-- Left Column: Form Card Container -->
      <div class="lg:col-span-7 xl:col-span-7 order-1">
        <div id="career-form-card" class="relative z-20 rounded-[28px] border border-border/80 bg-card/80 p-6 sm:p-8 md:p-10 shadow-sm backdrop-blur-md transition-all duration-300 hover:border-brand/30 hover:shadow-md">
          <!-- Section Header -->
          <div class="text-left mb-6 sm:mb-8">
            <span class="inline-flex items-center gap-1.5 rounded-full bg-brand/10 px-3 py-1 text-xs font-semibold text-brand mb-3">
              Talent Application
            </span>
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-foreground">
              Apply to Work with AKSNOVA
            </h2>
            <p class="mt-2 text-sm sm:text-base text-muted-foreground leading-relaxed">
              Share your qualifications and preferred job role. Our recruitment team reviews every profile and connects with matching opportunities.
            </p>
          </div>

      <!-- Application Form -->
      <form id="career-applicant-form" class="space-y-6" novalidate>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <!-- Full Name -->
          <div class="space-y-1.5">
            <label for="applicant-name" class="block text-sm font-semibold text-foreground">
              Full name <span class="text-brand" aria-hidden="true">*</span>
            </label>
            <div class="relative group">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-muted-foreground/60 group-focus-within:text-brand transition-colors">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
              </div>
              <input
                type="text"
                id="applicant-name"
                name="name"
                required
                minlength="2"
                maxlength="80"
                placeholder="e.g. Aditi Sharma"
                class="form-input-field pl-10"
              />
            </div>
            <p id="err-applicant-name" class="hidden text-xs text-red-500 font-medium transition-all"></p>
          </div>

          <!-- Contact Number -->
          <div class="space-y-1.5">
            <label for="applicant-phone" class="block text-sm font-semibold text-foreground">
              Contact number <span class="text-brand" aria-hidden="true">*</span>
            </label>
            <div class="relative group">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-muted-foreground/80 font-semibold text-xs border-r border-border/80 pr-2.5 group-focus-within:text-brand group-focus-within:border-brand/40 transition-colors">
                +91
              </div>
              <input
                type="tel"
                id="applicant-phone"
                name="phone"
                required
                pattern="[1-9][0-9]{9}"
                maxlength="10"
                inputmode="numeric"
                placeholder="98765 43210"
                class="form-input-field pl-16"
              />
            </div>
            <p id="err-applicant-phone" class="hidden text-xs text-red-500 font-medium transition-all"></p>
          </div>

          <!-- Educational Qualification -->
          <div class="space-y-1.5">
            <label for="applicant-qualification" class="block text-sm font-semibold text-foreground">
              Highest qualification <span class="text-brand" aria-hidden="true">*</span>
            </label>
            <div class="relative group">
              <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-muted-foreground/60 group-focus-within:text-brand transition-colors">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 14v7" />
                </svg>
              </div>
              <select
                id="applicant-qualification"
                name="qualification"
                required
                class="form-input-field pl-10 pr-10 appearance-none cursor-pointer"
              >
                <option value="" disabled selected>Select your qualification</option>
                <option value="B.Tech / B.E (CS / IT / EC / EE)">B.Tech / B.E (CS / IT / EC / EE)</option>
                <option value="BCA / MCA">BCA / MCA</option>
                <option value="B.Sc / M.Sc (Computer Science / Data / Math)">B.Sc / M.Sc (CS / IT / Math)</option>
                <option value="M.Tech / M.E">M.Tech / M.E</option>
                <option value="Diploma in Engineering / IT">Diploma in Engineering / IT</option>
                <option value="MBA / Post Graduate Degree">MBA / Post Graduate Degree</option>
                <option value="Graduate (Other Stream)">Graduate (Other Stream)</option>
                <option value="Working Professional">Working Professional</option>
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-3.5 text-muted-foreground/60">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </div>
            </div>
            <p id="err-applicant-qualification" class="hidden text-xs text-red-500 font-medium transition-all"></p>
          </div>

          <!-- Looking for Job Role (Dropdown Scrollable Option) -->
          <div class="space-y-1.5 relative z-40" id="role-dropdown-container">
            <label for="role-dropdown-btn" class="block text-sm font-semibold text-foreground">
              Looking for job role <span class="text-brand" aria-hidden="true">*</span>
            </label>
            <div class="relative">
              <!-- Custom Trigger Button -->
              <button
                type="button"
                id="role-dropdown-btn"
                aria-haspopup="listbox"
                aria-expanded="false"
                class="form-input-field flex items-center justify-between pl-10 pr-4 text-left cursor-pointer transition-all duration-200"
              >
                <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3.5 text-muted-foreground/60 group-focus-within:text-brand transition-colors">
                  <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <span id="role-selected-label" class="truncate text-sm text-muted-foreground/60">
                  Select a job role
                </span>
                <svg
                  id="role-chevron"
                  class="h-4 w-4 text-muted-foreground/70 shrink-0 transition-transform duration-200"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <!-- Hidden input bound for validation and payload submission -->
              <input type="hidden" id="applicant-role" name="role" required />

              <!-- Scrollable Dropdown Menu -->
              <div
                id="role-dropdown-menu"
                role="listbox"
                class="hidden absolute left-0 right-0 top-full mt-2 z-50 rounded-2xl border border-border bg-card shadow-2xl overflow-hidden transition-all"
              >
                <div class="max-h-64 overflow-y-auto p-2 pr-1.5 custom-scrollbar">
                  <!-- Group 1: Instruction & Mentorship -->
                  <div class="px-3 pt-2 pb-1 text-xs font-semibold text-brand">
                    Training and mentorship
                  </div>
                  <button type="button" role="option" data-value="Full Stack Web Development Trainer" class="role-option-item">
                    <span>Full Stack Web Development Trainer</span>
                  </button>
                  <button type="button" role="option" data-value="Data Science & AI / ML Mentor" class="role-option-item">
                    <span>Data Science & AI / ML Mentor</span>
                  </button>
                  <button type="button" role="option" data-value="Python Programming Instructor" class="role-option-item">
                    <span>Python Programming Instructor</span>
                  </button>
                  <button type="button" role="option" data-value="Java Enterprise Developer / Trainer" class="role-option-item">
                    <span>Java Enterprise Developer / Trainer</span>
                  </button>
                  <button type="button" role="option" data-value="Cloud Computing & DevOps Mentor" class="role-option-item">
                    <span>Cloud Computing & DevOps Mentor</span>
                  </button>
                  <button type="button" role="option" data-value="Cyber Security & Ethical Hacking Instructor" class="role-option-item">
                    <span>Cyber Security & Ethical Hacking Instructor</span>
                  </button>
                  <button type="button" role="option" data-value="UI/UX Design Mentor" class="role-option-item">
                    <span>UI/UX Design Mentor</span>
                  </button>
                  <button type="button" role="option" data-value="Data Analytics & Power BI Trainer" class="role-option-item">
                    <span>Data Analytics & Power BI Trainer</span>
                  </button>
                  <button type="button" role="option" data-value="Digital Marketing Specialist / Trainer" class="role-option-item">
                    <span>Digital Marketing Specialist / Trainer</span>
                  </button>
                  <button type="button" role="option" data-value="Software & Automation Testing Instructor" class="role-option-item">
                    <span>Software & Automation Testing Instructor</span>
                  </button>
                  <button type="button" role="option" data-value="Accounting with Tally Prime & GST Faculty" class="role-option-item">
                    <span>Accounting with Tally Prime & GST Faculty</span>
                  </button>

                  <!-- Group 2: Engineering & Tech -->
                  <div class="px-3 pt-3 pb-1 text-xs font-semibold text-brand border-t border-border/50 mt-1">
                    Engineering and tech
                  </div>
                  <button type="button" role="option" data-value="Frontend Developer (React / Next.js)" class="role-option-item">
                    <span>Frontend Developer (React / Next.js)</span>
                  </button>
                  <button type="button" role="option" data-value="Backend Developer (Node.js / Python)" class="role-option-item">
                    <span>Backend Developer (Node.js / Python)</span>
                  </button>
                  <button type="button" role="option" data-value="Full Stack Developer" class="role-option-item">
                    <span>Full Stack Developer</span>
                  </button>
                  <button type="button" role="option" data-value="DevOps & Infrastructure Engineer" class="role-option-item">
                    <span>DevOps & Infrastructure Engineer</span>
                  </button>
                  <button type="button" role="option" data-value="AI / Machine Learning Engineer" class="role-option-item">
                    <span>AI / Machine Learning Engineer</span>
                  </button>

                  <!-- Group 3: Operations & Student Success -->
                  <div class="px-3 pt-3 pb-1 text-xs font-semibold text-brand border-t border-border/50 mt-1">
                    Admissions, placement and operations
                  </div>
                  <button type="button" role="option" data-value="Academic & Career Counsellor" class="role-option-item">
                    <span>Academic & Career Counsellor</span>
                  </button>
                  <button type="button" role="option" data-value="Student Placement & Corporate Relations Lead" class="role-option-item">
                    <span>Student Placement & Corporate Relations Lead</span>
                  </button>
                  <button type="button" role="option" data-value="Curriculum & Technical Content Developer" class="role-option-item">
                    <span>Curriculum & Technical Content Developer</span>
                  </button>
                  <button type="button" role="option" data-value="Student Success & Support Executive" class="role-option-item">
                    <span>Student Success & Support Executive</span>
                  </button>
                  <button type="button" role="option" data-value="Business Development Executive" class="role-option-item">
                    <span>Business Development Executive</span>
                  </button>

                  <!-- Group 4: Other -->
                  <div class="px-3 pt-3 pb-1 text-xs font-semibold text-brand border-t border-border/50 mt-1">
                    Other
                  </div>
                  <button type="button" role="option" data-value="Other / Open Application" class="role-option-item">
                    <span>Other / Open Application</span>
                  </button>
                </div>
              </div>
            </div>
            <p id="err-applicant-role" class="hidden text-xs text-red-500 font-medium transition-all"></p>
          </div>
        </div>

        <!-- Submit Button -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-xs text-muted-foreground text-center sm:text-left">
            We value your privacy. Details are solely used for recruitment at AKSNOVA.
          </p>
          <button
            type="submit"
            id="applicant-submit-btn"
            class="group relative inline-flex h-12 w-full sm:w-auto min-w-[200px] items-center justify-center gap-2 rounded-2xl bg-brand px-7 text-sm font-semibold text-primary-foreground shadow-sm transition-all duration-300 hover:bg-brand-deep hover:shadow-md hover:shadow-brand/25 active:scale-[0.98] disabled:cursor-not-allowed disabled:opacity-60 cursor-pointer overflow-hidden"
          >
            <span id="applicant-btn-text" class="flex items-center gap-2">
              Send application
              <svg
                class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </span>
            <span id="applicant-btn-spinner" class="hidden items-center gap-2">
              <svg class="h-4 w-4 animate-spin text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
              </svg>
              Sending...
            </span>
          </button>
        </div>

        <!-- Feedback Banner -->
        <div id="applicant-feedback" class="hidden rounded-2xl p-4 text-sm font-medium transition-all" role="alert"></div>
      </form>
    </div>
  </div>

  <!-- Right Column: Software Development Animation -->
  <div class="lg:col-span-5 xl:col-span-5 order-2 flex flex-col items-center justify-center p-2 sm:p-4 overflow-visible">
    <div class="relative w-full max-w-md lg:max-w-none flex flex-col items-center justify-center overflow-visible">
      <!-- Ambient glow backdrop -->
      <div class="pointer-events-none absolute -inset-6 rounded-full bg-brand/10 blur-3xl opacity-60 dark:opacity-40"></div>

      <div
        id="software-dev-lottie-container"
        class="relative w-full flex items-center justify-center overflow-visible"
        data-lottie-src={softwareLottieUrl}
        data-wasm-src={wasmUrl}
        data-json-src={softwareJsonUrl}
      >
        <canvas
          id="software-dev-canvas"
          class="w-full h-auto drop-shadow-md select-none scale-100 sm:scale-105 transition-transform origin-center"
          style="aspect-ratio: 1 / 1; width: 100%; max-height: 520px; object-fit: contain;"
        ></canvas>
      </div>

      <!-- Supportive caption -->
      <div class="mt-4 text-center">
        <p class="text-xs sm:text-sm font-semibold text-foreground/85 tracking-wide">
          Engineering &bull; Teaching &bull; Mentorship
        </p>
        <p class="mt-1 text-xs text-muted-foreground">
          Empowering learners through real-world tech & training
        </p>
      </div>
    </div>
  </div>
</div>

    <!-- Below Form: AKSNOVA Direct Contact Info -->
    <div class="relative z-[1] mt-8 rounded-3xl border border-border/70 bg-card/50 p-6 sm:p-8 backdrop-blur transition-all duration-300 hover:border-border">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
        <div>
          <h3 class="text-lg sm:text-xl font-bold tracking-tight text-foreground">
            Prefer to reach the AKSNOVA team directly?
          </h3>
          <p class="mt-1 text-xs sm:text-sm text-muted-foreground leading-relaxed">
            Call our talent desk or email your resume and portfolio directly.
          </p>
        </div>

        <!-- Contact Badges / Action Links -->
        <div class="flex flex-wrap items-center gap-3">
          <!-- Direct Desk -->
          <a
            href="tel:+917977479948"
            class="group inline-flex items-center gap-3 rounded-2xl border border-border bg-background px-5 py-3 text-xs sm:text-sm font-semibold text-foreground transition-all duration-200 hover:border-brand/50 hover:bg-brand/5 hover:text-brand"
            aria-label="Call AKSNOVA Direct Desk at +91 7977479948"
          >
            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-brand/10 text-brand transition-colors group-hover:bg-brand group-hover:text-primary-foreground">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <div class="flex flex-col text-left">
              <span class="text-xs text-muted-foreground font-medium">Direct desk</span>
              <span class="font-bold tracking-wide text-sm">+91 7977479948</span>
            </div>
          </a>

          <!-- Email -->
          <a
            href="mailto:hello@aksnova.in?subject=Career%20Application%20at%20AKSNOVA"
            class="group inline-flex items-center gap-3 rounded-2xl border border-border bg-background px-5 py-3 text-xs sm:text-sm font-semibold text-foreground transition-all duration-200 hover:border-brand/50 hover:bg-brand/5 hover:text-brand"
            aria-label="Email AKSNOVA Careers at hello@aksnova.in"
          >
            <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-brand/10 text-brand transition-colors group-hover:bg-brand group-hover:text-primary-foreground">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="flex flex-col text-left">
              <span class="text-xs text-muted-foreground font-medium">Email</span>
              <span class="font-bold tracking-wide text-sm">hello@aksnova.in</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .form-input-field {
    width: 100%;
    height: 3rem;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background-color: var(--background);
    padding-right: 1rem;
    font-size: 0.875rem;
    color: var(--foreground);
    outline: none;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .form-input-field::placeholder {
    color: var(--muted-foreground);
    opacity: 0.6;
  }

  .form-input-field:focus,
  .form-input-field.dropdown-active {
    border-color: var(--brand);
    box-shadow: 0 0 0 3px oklch(0.6 0.23 27 / 0.15);
    transform: translateY(-1px);
  }

  /* Role item button inside scrollable dropdown */
  .role-option-item {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    border-radius: 0.75rem;
    padding: 0.5rem 0.75rem;
    text-align: left;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--foreground);
    transition: all 0.15s ease;
    cursor: pointer;
    border: none;
    background: transparent;
  }

  .role-option-item:hover {
    background-color: oklch(0.6 0.23 27 / 0.1);
    color: var(--brand);
    padding-left: 0.875rem;
  }

  .role-option-item.selected {
    background-color: oklch(0.6 0.23 27 / 0.15);
    color: var(--brand);
    font-weight: 600;
  }

  /* Custom smooth thin scrollbar that stays neatly inset within rounded borders */
  .custom-scrollbar {
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }

  .custom-scrollbar::-webkit-scrollbar-track {
    background: transparent;
    margin-top: 10px;
    margin-bottom: 10px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb {
    background-color: var(--border);
    border-radius: 9999px;
  }

  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background-color: var(--muted-foreground);
  }

  #role-dropdown-menu {
    background-color: var(--card);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4), 0 0 0 1px var(--border);
  }
</style>

<script is:inline>
  (() => {
    const form = document.getElementById('career-applicant-form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';

    const nameInput = document.getElementById('applicant-name');
    const phoneInput = document.getElementById('applicant-phone');
    const qualSelect = document.getElementById('applicant-qualification');
    const roleHiddenInput = document.getElementById('applicant-role');

    // Role Dropdown elements
    const roleContainer = document.getElementById('role-dropdown-container');
    const roleBtn = document.getElementById('role-dropdown-btn');
    const roleLabel = document.getElementById('role-selected-label');
    const roleMenu = document.getElementById('role-dropdown-menu');
    const roleChevron = document.getElementById('role-chevron');
    const roleOptions = document.querySelectorAll('.role-option-item');

    const errName = document.getElementById('err-applicant-name');
    const errPhone = document.getElementById('err-applicant-phone');
    const errQual = document.getElementById('err-applicant-qualification');
    const errRole = document.getElementById('err-applicant-role');

    const submitBtn = document.getElementById('applicant-submit-btn');
    const btnText = document.getElementById('applicant-btn-text');
    const btnSpinner = document.getElementById('applicant-btn-spinner');
    const feedback = document.getElementById('applicant-feedback');

    // Toggle Dropdown State
    function toggleDropdown(show) {
      const isExpanded = show !== undefined ? show : roleMenu.classList.contains('hidden');
      if (isExpanded) {
        roleMenu.classList.remove('hidden');
        roleBtn.setAttribute('aria-expanded', 'true');
        roleBtn.classList.add('dropdown-active');
        if (roleChevron) roleChevron.style.transform = 'rotate(180deg)';
        if (roleContainer) roleContainer.style.zIndex = '30';
      } else {
        roleMenu.classList.add('hidden');
        roleBtn.setAttribute('aria-expanded', 'false');
        roleBtn.classList.remove('dropdown-active');
        if (roleChevron) roleChevron.style.transform = 'rotate(0deg)';
        if (roleContainer) roleContainer.style.zIndex = '20';
      }
    }

    if (roleBtn) {
      roleBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        toggleDropdown();
      });
    }

    // Role selection handling
    roleOptions.forEach((option) => {
      option.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const value = option.getAttribute('data-value') || '';
        if (roleHiddenInput) {
          roleHiddenInput.value = value;
        }
        if (roleLabel) {
          roleLabel.textContent = value;
          roleLabel.classList.remove('text-muted-foreground/60');
          roleLabel.classList.add('text-foreground', 'font-medium');
        }

        roleOptions.forEach((opt) => opt.classList.remove('selected'));
        option.classList.add('selected');

        if (errRole) {
          errRole.textContent = '';
          errRole.classList.add('hidden');
        }

        toggleDropdown(false);
      });
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (roleContainer && !roleContainer.contains(e.target)) {
        toggleDropdown(false);
      }
    });

    // Close on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        toggleDropdown(false);
      }
    });

    // Enforce 10 digits only and forbid starting with 0
    if (phoneInput) {
      phoneInput.addEventListener('input', () => {
        let val = phoneInput.value.replace(/\D/g, '');
        // If user pastes 12 digits starting with country code 91, strip 91
        if (val.length === 12 && val.startsWith('91')) {
          val = val.slice(2);
        }
        // Disallow leading zeros
        val = val.replace(/^0+/, '');
        // Limit strictly to 10 digits
        if (val.length > 10) {
          val = val.slice(0, 10);
        }
        phoneInput.value = val;

        if (errPhone && !errPhone.classList.contains('hidden')) {
          if (/^[1-9][0-9]{9}$/.test(val)) {
            errPhone.textContent = '';
            errPhone.classList.add('hidden');
          }
        }
      });

      phoneInput.addEventListener('keydown', (e) => {
        // Block typing '0' if the field is empty or selection is at the start
        if (e.key === '0' && (phoneInput.value.length === 0 || (phoneInput.selectionStart === 0 && phoneInput.selectionEnd === 0))) {
          e.preventDefault();
        }
      });
    }

    // Supabase project constants
    const SUPABASE_URL = 'https://aehbrvlqyavkfgmkadtl.supabase.co';
    const SUPABASE_KEY = 'sb_publishable_r2sRtssLVNSAzT9eOvvn9A_V-84vPxR';

    function clearErrors() {
      [errName, errPhone, errQual, errRole].forEach((el) => {
        if (el) {
          el.textContent = '';
          el.classList.add('hidden');
        }
      });
      if (feedback) {
        feedback.className = 'hidden rounded-2xl p-4 text-sm font-medium transition-all';
        feedback.textContent = '';
      }
    }

    function showFieldError(el, message) {
      if (el) {
        el.textContent = message;
        el.classList.remove('hidden');
      }
    }

    function setSubmitting(isSubmitting) {
      if (submitBtn) submitBtn.disabled = isSubmitting;
      if (btnText && btnSpinner) {
        if (isSubmitting) {
          btnText.classList.add('hidden');
          btnSpinner.classList.remove('hidden');
          btnSpinner.classList.add('flex');
        } else {
          btnText.classList.remove('hidden');
          btnSpinner.classList.remove('flex');
          btnSpinner.classList.add('hidden');
        }
      }
    }

    function validate() {
      clearErrors();
      let isValid = true;

      // Validate Name
      const nameVal = (nameInput?.value || '').trim();
      if (!nameVal || nameVal.length < 2) {
        showFieldError(errName, 'Enter your full name (at least 2 characters).');
        isValid = false;
      }

      // Validate Phone: must be exactly 10 digits and not start with 0
      const rawNum = (phoneInput?.value || '').replace(/\D/g, '');
      const normalizedPhone = rawNum.length === 12 && rawNum.startsWith('91') ? rawNum.slice(2) : rawNum;
      if (!normalizedPhone) {
        showFieldError(errPhone, 'Enter your 10-digit mobile number.');
        isValid = false;
      } else if (normalizedPhone.startsWith('0')) {
        showFieldError(errPhone, 'Mobile number cannot start with 0.');
        isValid = false;
      } else if (normalizedPhone.length !== 10) {
        showFieldError(errPhone, 'Enter a valid 10-digit mobile number.');
        isValid = false;
      }

      // Validate Qualification
      const qualVal = (qualSelect?.value || '').trim();
      if (!qualVal) {
        showFieldError(errQual, 'Select your highest qualification.');
        isValid = false;
      }

      // Validate Role from hidden input
      const roleVal = (roleHiddenInput?.value || '').trim();
      if (!roleVal || roleVal.length < 2) {
        showFieldError(errRole, 'Select a job role from the list.');
        if (roleBtn) roleBtn.focus();
        isValid = false;
      }

      return isValid;
    }

    async function sendApplication(payload) {
      const headers = {
        'Content-Type': 'application/json',
        'apikey': SUPABASE_KEY,
        'Authorization': `Bearer ${SUPABASE_KEY}`,
        'Prefer': 'return=minimal',
      };

      const hiringData = {
        name: payload.name,
        phone: payload.phone,
        qualification: payload.qualification,
        role: payload.role,
      };

      try {
        // 1. Direct insert into Supabase "Hiring" table (exact case)
        const endpointExact = `${SUPABASE_URL}/rest/v1/Hiring`;
        const resExact = await fetch(endpointExact, {
          method: 'POST',
          headers,
          body: JSON.stringify([hiringData]),
        });

        if (resExact.ok) return { success: true };

        // 2. Fallback to lowercase "hiring" table
        if (resExact.status === 404) {
          const endpointLower = `${SUPABASE_URL}/rest/v1/hiring`;
          const resLower = await fetch(endpointLower, {
            method: 'POST',
            headers,
            body: JSON.stringify([hiringData]),
          });
          if (resLower.ok) return { success: true };
        }

        const errText = await resExact.text().catch(() => '');
        console.error('Supabase Hiring insert error:', resExact.status, errText);
        return { success: false, error: 'Database rejected application.' };
      } catch (err) {
        console.error('Error submitting application to Hiring table:', err);
        return { success: false, error: 'Network error occurred.' };
      }
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!validate()) return;

      const rawNum = (phoneInput?.value || '').replace(/\D/g, '');
      const phone = rawNum.length === 12 && rawNum.startsWith('91') ? rawNum.slice(2) : rawNum;
      const name = (nameInput?.value || '').trim();
      const qualification = (qualSelect?.value || '').trim();
      const role = (roleHiddenInput?.value || '').trim();

      const payload = {
        name,
        phone,
        qualification,
        role,
      };

      setSubmitting(true);
      const result = await sendApplication(payload);
      setSubmitting(false);

      if (!feedback) return;

      if (!result.success) {
        feedback.classList.remove('hidden');
        feedback.className = 'rounded-2xl p-5 text-sm font-medium bg-red-500/10 text-red-700 dark:text-red-400 border border-red-500/25 space-y-1.5 animate-in fade-in zoom-in-95 duration-300';
        feedback.innerHTML = `
          <div class="flex items-start gap-3">
            <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-red-500 text-white">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-base text-foreground">Submission could not be completed</p>
              <p class="mt-1 text-muted-foreground">
                Unable to save your application right now. Please call our talent desk at <strong class="text-foreground">+91 7977479948</strong> or email us at <strong class="text-foreground">hello@aksnova.in</strong>.
              </p>
            </div>
          </div>
        `;
        return;
      }

      feedback.classList.remove('hidden');
      feedback.className = 'rounded-2xl p-5 text-sm font-medium bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 border border-emerald-500/25 space-y-1.5 animate-in fade-in zoom-in-95 duration-300';
      feedback.innerHTML = `
        <div class="flex items-start gap-3">
          <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-500 text-white">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <div>
            <p class="font-bold text-base text-foreground">Application received</p>
            <p class="mt-1 text-muted-foreground">
              Thank you, <strong class="text-foreground">${name}</strong>. Your profile for <strong class="text-brand">${role}</strong> (${qualification}) has been submitted. Our recruitment team will connect with you at <strong class="text-foreground">+91 ${phone}</strong>.
            </p>
          </div>
        </div>
      `;
      form.reset();
      if (roleLabel) {
        roleLabel.textContent = 'Select a job role';
        roleLabel.classList.remove('text-foreground', 'font-medium');
        roleLabel.classList.add('text-muted-foreground/60');
      }
      roleOptions.forEach((opt) => opt.classList.remove('selected'));
    });
  })();
</script>

<script>
  import { DotLottie } from '@lottiefiles/dotlottie-web';
  import lottie from 'lottie-web/build/player/lottie_light';

  const container = document.getElementById('software-dev-lottie-container');
  const canvas = document.getElementById('software-dev-canvas') as HTMLCanvasElement | null;

  if (container && canvas) {
    const lottieSrc = container.getAttribute('data-lottie-src') || '';
    const wasmSrc = container.getAttribute('data-wasm-src') || '';
    const jsonSrc = container.getAttribute('data-json-src') || '';

    let initialized = false;

    if (wasmSrc && typeof (DotLottie as any).setWasmUrl === 'function') {
      try {
        (DotLottie as any).setWasmUrl(wasmSrc);
      } catch (e) {
        console.warn('Could not set custom wasm URL for DotLottie:', e);
      }
    }

    const fallbackToSvg = () => {
      if (initialized) return;
      initialized = true;
      if (canvas && canvas.parentNode) {
        canvas.style.display = 'none';
      }
      if (jsonSrc) {
        lottie.loadAnimation({
          container,
          renderer: 'svg',
          loop: true,
          autoplay: true,
          path: jsonSrc,
        });
      }
    };

    if (lottieSrc) {
      try {
        const dotLottie = new DotLottie({
          canvas,
          src: lottieSrc,
          loop: true,
          autoplay: true,
          layout: {
            fit: 'contain',
            align: [0.5, 0.5],
          },
        });

        dotLottie.addEventListener('loadError', (err) => {
          console.warn('DotLottie load error, falling back to SVG renderer:', err);
          fallbackToSvg();
        });

        dotLottie.addEventListener('ready', () => {
          initialized = true;
        });
      } catch (err) {
        console.warn('DotLottie init failed, falling back to SVG renderer:', err);
        fallbackToSvg();
      }
    } else {
      fallbackToSvg();
    }
  }
</script>

