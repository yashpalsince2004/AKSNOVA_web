---
interface Props {
  slug: string;
  title: string;
  excerpt: string;
  category: string;
  heroImage: string;
  readingTime: number;
  tag?: string;
  large?: boolean;
}

const {
  slug,
  title,
  excerpt,
  category,
  heroImage,
  readingTime,
  tag,
  large = false,
} = Astro.props;
---

<a
  href={`/blog/${slug}`}
  class={`group relative block overflow-hidden rounded-2xl bg-card transition-all duration-300 hover:-translate-y-1 ${
    large ? 'min-h-[420px] lg:h-full' : 'min-h-[240px]'
  }`}
>
  <img
    src={heroImage}
    alt={title}
    loading="lazy"
    class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
  />
  <div class="hero-shade absolute inset-0" />
  
  <div class={`absolute inset-x-0 bottom-0 text-hero-ink ${large ? 'p-8 md:p-10' : 'p-5'}`}>
    <span class="rounded-full bg-background/90 backdrop-blur-sm px-3 py-1 text-xs font-bold text-foreground">
      {category}
    </span>
    <h3 class={`mt-3 font-bold leading-tight ${large ? 'text-2xl sm:text-3xl md:text-[38px]' : 'text-lg'}`}>
      {title}
    </h3>
    {large && (
      <p class="mt-3 max-w-xl text-sm opacity-90 line-clamp-3">
        {excerpt}
      </p>
    )}
    <div class="mt-2.5 text-xs font-semibold opacity-80 flex items-center gap-2">
      {tag && <span>{tag}</span>}
      {tag && <span>·</span>}
      <span>{readingTime} min read</span>
    </div>
    {large && (
      <span class="mt-6 inline-flex items-center gap-2 rounded-2xl bg-brand px-5 py-3 text-sm font-bold text-primary-foreground shadow-md transition group-hover:bg-brand-deep">
        Read article
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </span>
    )}
  </div>
</a>
