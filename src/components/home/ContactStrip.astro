---
// Quick enquiry & contact banner for homepage
---

<section id="contact-strip" class="mx-auto max-w-7xl px-4 pb-16 md:px-6">
  <div class="grid gap-10 rounded-[32px] bg-card border border-border p-8 sm:p-12 md:p-14 lg:grid-cols-2 items-center">
    <div>
      <p class="eyebrow">Get started</p>
      <h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight text-foreground">
        Book your free career counselling
      </h2>
      <p class="mt-3 text-muted-foreground leading-relaxed text-base">
        Tell us your career goals — our academic mentors will recommend the ideal curriculum, batch schedule, and roadmap for you.
      </p>

      <ul class="mt-8 flex flex-wrap gap-2.5 text-xs sm:text-sm">
        <li class="flex items-center gap-2 rounded-full bg-background border border-border px-4 py-2 text-foreground font-medium">
          <svg class="h-4 w-4 text-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          +91 00000 00000
        </li>
        <li class="flex items-center gap-2 rounded-full bg-background border border-border px-4 py-2 text-foreground font-medium">
          <svg class="h-4 w-4 text-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          hello@aksnova.in
        </li>
        <li class="flex items-center gap-2 rounded-full bg-background border border-border px-4 py-2 text-foreground font-medium">
          <svg class="h-4 w-4 text-brand shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
          AKSNOVA Training Center
        </li>
      </ul>
    </div>

    <div class="flex flex-col justify-center gap-3.5 bg-background/50 rounded-2xl p-6 sm:p-8 border border-border/80">
      <h3 class="text-xl font-bold text-foreground">Speak with a Counsellor Today</h3>
      <p class="text-sm text-muted-foreground">
        Get tailored answers about fees, batch timings, EMI options, and syllabus details.
      </p>
      <a
        href="/contact"
        class="mt-2 flex h-12 items-center justify-center rounded-2xl bg-brand text-sm font-bold text-primary-foreground shadow-md transition hover:bg-brand-deep"
      >
        Request a Callback
      </a>
      <p class="text-center text-xs text-muted-foreground">
        Or visit our <a href="/contact" class="font-semibold text-foreground underline underline-offset-2">contact page</a> for walk-in address and directions.
      </p>
    </div>
  </div>
</section>
