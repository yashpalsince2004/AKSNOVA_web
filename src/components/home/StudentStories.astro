---
export const stories = [
  {
    name: 'Priya S.',
    role: 'Data Analyst',
    company: 'DataForge',
    quote: 'The projects I built during the course were exactly what my interviewers asked about. The practical SQL and Python assignments set me apart.',
  },
  {
    name: 'Rahul M.',
    role: 'Full Stack Developer',
    company: 'Codeyard',
    quote: 'Mock technical interviews made the real ones feel completely familiar. I received my job offer within 3 weeks of finishing the capstone project.',
  },
  {
    name: 'Sneha K.',
    role: 'Accounts Executive',
    company: 'Finserve',
    quote: 'The Tally and GST training was hands-on from day one. Working with real company invoices gave me the exact skills needed on the job.',
  },
];
---

<section id="stories" aria-labelledby="stories-title" class="mx-auto max-w-7xl px-4 py-16 md:px-6">
  <div class="max-w-2xl">
    <p class="eyebrow">Student Stories</p>
    <h2 id="stories-title" class="mt-3 text-3xl font-bold tracking-tight md:text-4xl text-foreground">
      Real students. Real career breakthroughs.
    </h2>
    <p class="mt-3 text-muted-foreground">
      Hear directly from alumni who transitioned from beginners to working professionals.
    </p>
  </div>

  <div class="mt-10 grid gap-4 md:grid-cols-3">
    {stories.map((s) => (
      <figure class="rounded-2xl bg-card p-8 border border-border/50 flex flex-col justify-between transition-colors hover:border-brand/40">
        <blockquote class="text-base text-foreground/90 leading-relaxed italic">
          “{s.quote}”
        </blockquote>
        <figcaption class="mt-8 flex items-center gap-3.5 border-t border-border/60 pt-4">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-brand text-base font-black text-primary-foreground">
            {s.name[0]}
          </span>
          <div>
            <div class="text-sm font-bold text-foreground">{s.name}</div>
            <div class="text-xs text-muted-foreground">
              {s.role} · <span class="font-semibold text-brand">{s.company}</span>
            </div>
          </div>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
