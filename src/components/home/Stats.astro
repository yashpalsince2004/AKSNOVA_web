---
export const stats = [
  ['5,000+', 'Students trained'],
  ['40+', 'Career courses'],
  ['250+', 'Hiring partners'],
  ['92%', 'Placement assistance rate'],
];
---

<section aria-label="Key statistics" class="mx-auto mt-4 grid max-w-7xl grid-cols-2 gap-2 px-4 md:grid-cols-4 md:px-6">
  {stats.map(([num, label]) => (
    <div class="rounded-2xl bg-card p-6 border border-border/50 transition-colors hover:border-brand/40">
      <div class="text-3xl sm:text-4xl font-bold tracking-[-0.8px] text-brand md:text-[44px]">
        {num}
      </div>
      <div class="mt-1 text-sm text-muted-foreground font-medium">
        {label}
      </div>
    </div>
  ))}
</section>
