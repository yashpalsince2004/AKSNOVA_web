---
const steps = [
  {
    step: 'Step 1',
    title: 'Learn',
    desc: 'Structured, mentor-led curriculum from fundamentals to advanced.',
    icon: `<svg class="h-5 w-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>`,
  },
  {
    step: 'Step 2',
    title: 'Build',
    desc: 'Real industry projects that verify your skills in your public portfolio.',
    icon: `<svg class="h-5 w-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" /></svg>`,
  },
  {
    step: 'Step 3',
    title: 'Certify',
    desc: 'Recognised AKSNOVA certification verifying practical competence.',
    icon: `<svg class="h-5 w-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>`,
  },
  {
    step: 'Step 4',
    title: 'Intern',
    desc: 'Hands-on internship experience working on real business scenarios.',
    icon: `<svg class="h-5 w-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  },
  {
    step: 'Step 5',
    title: 'Prepare',
    desc: 'Mock technical coding challenges and HR interview simulations.',
    icon: `<svg class="h-5 w-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>`,
  },
  {
    step: 'Step 6',
    title: 'Get Hired',
    desc: 'Direct interview scheduling with our 250+ hiring partner network.',
    icon: `<svg class="h-5 w-5 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  },
];
---

<section id="journey" aria-labelledby="journey-title" class="mx-auto max-w-7xl px-4 py-16 md:px-6">
  <div class="max-w-2xl">
    <p class="eyebrow">Your journey</p>
    <h2 id="journey-title" class="mt-3 text-3xl font-bold tracking-tight md:text-4xl text-foreground">
      Learn. Build. Get Hired.
    </h2>
    <p class="mt-3 text-muted-foreground">
      One structured, proven path — from your very first class to your first job offer letter.
    </p>
  </div>

  <ol class="mt-10 grid gap-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6">
    {steps.map(({ step, title, desc, icon }) => (
      <li class="group rounded-2xl bg-card p-6 transition-all duration-300 hover:bg-secondary hover:-translate-y-1 border border-border/50">
        <div class="flex h-10 w-10 items-center justify-center rounded-full bg-background shadow-sm">
          <span set:html={icon} />
        </div>
        <div class="mt-6 text-xs font-bold uppercase tracking-wider text-muted-foreground">
          {step}
        </div>
        <h3 class="mt-1 text-lg font-bold text-foreground">
          {title}
        </h3>
        <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">
          {desc}
        </p>
      </li>
    ))}
  </ol>
</section>
