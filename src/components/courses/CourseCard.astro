---
interface Props {
  title: string;
  slug: string;
  category: 'IT' | 'NON-IT';
  duration: string;
  mode: string;
  tags: string[];
  heroImage: string;
  index?: number;
}

const { title, slug, category, duration, mode, tags, heroImage, index = 0 } = Astro.props;
---

<article class="group relative block overflow-hidden rounded-2xl bg-card transition-all duration-300 hover:-translate-y-1">
  <a href={`/courses/${slug}`} class="block h-[340px] relative overflow-hidden rounded-2xl">
    <img
      src={heroImage}
      alt={title}
      loading="lazy"
      width="1024"
      height="768"
      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-black/45 dark:bg-black/30 transition-colors" />

    <!-- Category Pill -->
    <span class="absolute left-3 top-3 rounded-full bg-background/90 backdrop-blur-sm px-3 py-1.5 text-xs font-bold text-foreground">
      {category === 'IT' ? 'IT & Tech' : 'Professional'}
    </span>

    <!-- Floating details panel -->
    <div
      class="float-bob absolute inset-x-3 bottom-3"
      style={`animation-delay: ${index * 600}ms`}
    >
      <div class="shadow-float rounded-2xl bg-panel p-4 backdrop-blur-md border border-white/10 transition-transform duration-300 group-hover:-translate-y-1">
        <h3 class="text-lift text-xl font-extrabold leading-tight text-hero-ink">
          {title}
        </h3>
        <div class="mt-1 text-xs font-semibold text-hero-ink/80">
          {duration} · {mode}
        </div>
        <div class="mt-3 flex flex-wrap gap-1.5">
          {tags.slice(0, 3).map((t) => (
            <span class="rounded-full bg-hero-ink/20 px-2.5 py-1 text-[11px] font-bold text-hero-ink backdrop-blur-sm">
              {t}
            </span>
          ))}
        </div>
      </div>
    </div>
  </a>
</article>
