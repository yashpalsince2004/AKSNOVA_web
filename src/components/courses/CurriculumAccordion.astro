---
import type { CurriculumModule } from '@/data/courses/data-science';
import TechLogo from './TechLogo.astro';

interface Props {
  modules: CurriculumModule[];
}

const { modules } = Astro.props;

interface ProjectThemeConfig {
  tag: string;
  domainLabel: string;
  containerBg: string;
  iconBg: string;
  badgeStyle: string;
  brief: string;
  deliverables: string[];
  iconPath: 'chart' | 'database' | 'globe' | 'pin' | 'code' | 'scatter' | 'brain';
}

const projectThemes: Record<number, ProjectThemeConfig> = {
  1: {
    tag: 'Business Analytics Project',
    domainLabel: 'Sales & Revenue Intelligence',
    containerBg:
      'from-emerald-500/10 via-emerald-500/[0.03] to-teal-500/10 border-emerald-500/30 dark:border-emerald-400/20 hover:border-emerald-500/60 dark:hover:border-emerald-400/40',
    iconBg:
      'bg-emerald-500/15 border-emerald-500/30 text-emerald-700 dark:text-emerald-300',
    badgeStyle:
      'bg-emerald-500/15 text-emerald-800 dark:text-emerald-300 border-emerald-500/30',
    brief:
      'Transforms raw retail transactions into an automated executive spreadsheet dashboard tracking category margins, regional revenue trends, and key performance indicators.',
    deliverables: ['Executive KPI Dashboard', 'Automated Formulas', 'Pivot Summaries'],
    iconPath: 'chart',
  },
  2: {
    tag: 'Database System Project',
    domainLabel: 'Fintech & Relational Database',
    containerBg:
      'from-blue-500/10 via-blue-500/[0.03] to-cyan-500/10 border-blue-500/30 dark:border-blue-400/20 hover:border-blue-500/60 dark:hover:border-blue-400/40',
    iconBg:
      'bg-blue-500/15 border-blue-500/30 text-blue-700 dark:text-blue-300',
    badgeStyle:
      'bg-blue-500/15 text-blue-800 dark:text-blue-300 border-blue-500/30',
    brief:
      'Architects a normalized banking schema and writes production SQL queries to manage account transactions, calculate financial balances, and detect suspicious activity.',
    deliverables: ['Relational ER Schema', 'Multi-Table Joins', 'Audit & Anomaly Queries'],
    iconPath: 'database',
  },
  3: {
    tag: 'Business Intelligence Project',
    domainLabel: 'Demographic & Geospatial BI',
    containerBg:
      'from-amber-500/10 via-amber-500/[0.03] to-orange-500/10 border-amber-500/30 dark:border-amber-400/20 hover:border-amber-500/60 dark:hover:border-amber-400/40',
    iconBg:
      'bg-amber-500/15 border-amber-500/30 text-amber-800 dark:text-amber-300',
    badgeStyle:
      'bg-amber-500/15 text-amber-900 dark:text-amber-300 border-amber-500/30',
    brief:
      'Builds an interactive Power BI report connecting global population statistics with interactive map visuals, custom DAX measures, and drill-down demographic slicers.',
    deliverables: ['Cross-Filtered Reports', 'DAX Measures', 'Geographic Heatmaps'],
    iconPath: 'globe',
  },
  4: {
    tag: 'Visual Analytics Project',
    domainLabel: 'Hospitality & Market Intelligence',
    containerBg:
      'from-rose-500/10 via-rose-500/[0.03] to-orange-500/10 border-rose-500/30 dark:border-rose-400/20 hover:border-rose-500/60 dark:hover:border-rose-400/40',
    iconBg:
      'bg-rose-500/15 border-rose-500/30 text-rose-700 dark:text-rose-300',
    badgeStyle:
      'bg-rose-500/15 text-rose-800 dark:text-rose-300 border-rose-500/30',
    brief:
      'Investigates Airbnb rental listings across metropolitan districts to reveal pricing outliers, room type demand, occupancy cycles, and location-based profitability.',
    deliverables: ['Geospatial Map Story', 'Price Segmentation', 'Interactive Storyboards'],
    iconPath: 'pin',
  },
  5: {
    tag: 'Software Engineering Project',
    domainLabel: 'Python Architecture & Logic',
    containerBg:
      'from-indigo-500/10 via-indigo-500/[0.03] to-sky-500/10 border-indigo-500/30 dark:border-indigo-400/20 hover:border-indigo-500/60 dark:hover:border-indigo-400/40',
    iconBg:
      'bg-indigo-500/15 border-indigo-500/30 text-indigo-700 dark:text-indigo-300',
    badgeStyle:
      'bg-indigo-500/15 text-indigo-800 dark:text-indigo-300 border-indigo-500/30',
    brief:
      'Develops an object-oriented Python reservation engine implementing train routing algorithms, real-time seat allocation checks, ticket booking confirmation, and file persistence.',
    deliverables: ['Modular Python OOP', 'Booking Validation Logic', 'File Storage & CLI'],
    iconPath: 'code',
  },
  6: {
    tag: 'Exploratory Data Science Project',
    domainLabel: 'Statistical EDA & Visualization',
    containerBg:
      'from-teal-500/10 via-teal-500/[0.03] to-emerald-500/10 border-teal-500/30 dark:border-teal-400/20 hover:border-teal-500/60 dark:hover:border-teal-400/40',
    iconBg:
      'bg-teal-500/15 border-teal-500/30 text-teal-700 dark:text-teal-300',
    badgeStyle:
      'bg-teal-500/15 text-teal-800 dark:text-teal-300 border-teal-500/30',
    brief:
      'Executes end-to-end data wrangling on real enterprise retail data with Pandas and NumPy, discovering sales drivers through statistical tests and Seaborn correlation matrices.',
    deliverables: ['Data Wrangling Pipeline', 'Statistical Outlier Analysis', 'Seaborn Visual Charts'],
    iconPath: 'scatter',
  },
  7: {
    tag: 'Machine Learning Capstone',
    domainLabel: 'Predictive AI & Decision Support',
    containerBg:
      'from-purple-500/10 via-purple-500/[0.03] to-violet-500/10 border-purple-500/30 dark:border-purple-400/20 hover:border-purple-500/60 dark:hover:border-purple-400/40',
    iconBg:
      'bg-purple-500/15 border-purple-500/30 text-purple-700 dark:text-purple-300',
    badgeStyle:
      'bg-purple-500/15 text-purple-800 dark:text-purple-300 border-purple-500/30',
    brief:
      'Trains supervised regression and classification models with Scikit-learn alongside unsupervised customer segmentation clusters to forecast sales performance and churn risk.',
    deliverables: ['Predictive ML Models', 'Customer Segmentation', 'Model Evaluation & Metrics'],
    iconPath: 'brain',
  },
};
---

<div class="curriculum-accordion-root w-full" id="curriculum-accordion">
  <!-- Controls Row -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <div class="flex items-center gap-2 text-xs sm:text-sm text-muted-foreground font-medium">
      <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-secondary text-foreground font-semibold">
        <span class="h-2 w-2 rounded-full bg-brand"></span>
        {modules.length} Core Modules
      </span>
      <span>&bull;</span>
      <span>Click to explore</span>
    </div>

    <button
      type="button"
      id="accordion-collapse-all"
      class="inline-flex items-center gap-1.5 rounded-full border border-border/80 bg-secondary/80 px-3.5 py-1.5 text-xs font-bold text-foreground transition-all hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand cursor-pointer"
      aria-label="Collapse all modules"
    >
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 11l7-7 7 7M5 19l7-7 7 7" />
      </svg>
      <span>Collapse All</span>
    </button>
  </div>

  <!-- Modules List -->
  <div class="space-y-3">
    {modules.map((mod, idx) => {
      const isFirst = idx === 0;
      const headerId = `module-header-${mod.id}`;
      const panelId = `module-panel-${mod.id}`;
      // Extract clean section titles (strip numbering prefix)
      const sectionTitles = mod.submodules.map((sub) =>
        sub.title.replace(/^\d+\.\s*/, '')
      );
      const moduleTools = mod.tools && mod.tools.length > 0 ? mod.tools : mod.skillsDeveloped.slice(0, 4);
      const theme = projectThemes[mod.moduleNumber] || projectThemes[1];

      return (
        <div
          class="module-item group/mod rounded-2xl border border-border bg-card/70 transition-all duration-300 hover:border-brand/40 overflow-hidden shadow-xs scroll-mt-36"
          data-module-id={mod.id}
        >
          {/* ── Trigger Button ── */}
          <button
            type="button"
            id={headerId}
            aria-expanded={isFirst ? "true" : "false"}
            aria-controls={panelId}
            class="module-trigger w-full text-left p-4 sm:p-5 flex items-center justify-between gap-3 cursor-pointer select-none transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
          >
            <div class="flex items-center gap-3 flex-1 min-w-0">
              {/* Module Number */}
              <span class="module-number-badge flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-secondary text-foreground text-sm font-extrabold transition-all duration-300 group-hover/mod:bg-brand/10 group-hover/mod:text-brand">
                0{mod.moduleNumber}
              </span>

              <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-0.5">
                  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold tracking-wide uppercase bg-brand/10 text-brand">
                    {mod.domain.split(',')[0]}
                  </span>
                  <span class="text-[10px] text-muted-foreground font-semibold hidden sm:inline">
                    {mod.submodules.length} Sections
                  </span>
                </div>
                <h3 class="text-sm sm:text-base font-bold text-foreground leading-snug group-hover/mod:text-brand transition-colors truncate">
                  {mod.title}
                </h3>
              </div>
            </div>

            {/* Chevron */}
            <span class="chevron-wrapper flex h-8 w-8 items-center justify-center rounded-full bg-secondary text-foreground transition-all duration-300 group-hover/mod:bg-accent shrink-0">
              <svg
                class="chevron-icon h-4 w-4 transition-transform duration-300"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </button>

          {/* ── Expandable Panel ── */}
          <div
            id={panelId}
            role="region"
            aria-labelledby={headerId}
            class="module-panel grid transition-[grid-template-rows] duration-400 ease-out"
            style={isFirst ? "grid-template-rows: 1fr;" : "grid-template-rows: 0fr;"}
          >
            <div class="overflow-hidden">
              <div class="px-4 pb-5 sm:px-5 sm:pb-6 pt-1 border-t border-border/60">

                {/* ── What You'll Learn: Compact Topic Pills ── */}
                <div class="module-content-anim mb-4">
                  <h5 class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground mb-3">
                    What You'll Learn
                  </h5>
                  <div class="flex flex-wrap gap-1.5">
                    {sectionTitles.map((title, tIdx) => (
                      <span
                        class="topic-pill inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-secondary/70 text-xs font-medium text-foreground border border-border/40 transition-all duration-200 hover:bg-brand/10 hover:text-brand hover:border-brand/30"
                        style={`animation-delay: ${tIdx * 40}ms`}
                      >
                        <span class="h-1 w-1 rounded-full bg-brand/60 shrink-0"></span>
                        {title}
                      </span>
                    ))}
                  </div>
                </div>

                {/* ── Technologies Used: Authentic Colorful Brand Logo Cards ── */}
                {moduleTools.length > 0 && (
                  <div class="module-content-anim mb-4">
                    <h5 class="text-[11px] font-bold uppercase tracking-wider text-muted-foreground mb-2.5">
                      Technologies & Tools
                    </h5>
                    <div class="flex flex-wrap gap-2">
                      {moduleTools.map((tool, toolIdx) => (
                        <div
                          class="tech-card group/tech flex items-center gap-2 px-3 py-1.5 rounded-xl bg-background border border-border/70 shadow-xs transition-all duration-200 hover:border-foreground/30 hover:shadow-sm"
                          style={`animation-delay: ${toolIdx * 50}ms`}
                        >
                          <div class="flex h-5 w-5 items-center justify-center shrink-0">
                            <TechLogo name={tool} class="h-4.5 w-4.5 drop-shadow-xs transition-transform duration-200 group-hover/tech:scale-110" />
                          </div>
                          <span class="text-xs font-semibold text-foreground whitespace-nowrap">
                            {tool}
                          </span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                {/* ── Module Practical Project Showcase Card (Themed, Non-Red, Dark/Light Harmonious) ── */}
                <div class={`module-content-anim project-card rounded-2xl border p-4 sm:p-5 bg-gradient-to-br transition-all duration-300 shadow-xs hover:shadow-md ${theme.containerBg}`}>
                  <div class="flex items-start gap-3.5 sm:gap-4">
                    {/* Themed Project SVG Icon Box */}
                    <div class={`flex h-11 w-11 sm:h-12 sm:w-12 shrink-0 items-center justify-center rounded-xl border shadow-xs transition-transform duration-200 hover:scale-105 ${theme.iconBg}`}>
                      {theme.iconPath === 'chart' && (
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 3v18h18" />
                          <path d="M7 13l4-4 4 3 5-7" />
                          <path d="M16 5h4v4" />
                          <rect x="7" y="13" width="3.5" height="5" rx="0.5" fill="currentColor" fill-opacity="0.25" />
                          <rect x="12" y="10" width="3.5" height="8" rx="0.5" fill="currentColor" fill-opacity="0.25" />
                          <rect x="17" y="7" width="3.5" height="11" rx="0.5" fill="currentColor" fill-opacity="0.25" />
                        </svg>
                      )}
                      {theme.iconPath === 'database' && (
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <ellipse cx="12" cy="5" rx="8" ry="3" fill="currentColor" fill-opacity="0.25" />
                          <path d="M4 5v6c0 1.66 3.58 3 8 3s8-1.34 8-3V5" />
                          <path d="M4 11v6c0 1.66 3.58 3 8 3s8-1.34 8-3v-6" />
                        </svg>
                      )}
                      {theme.iconPath === 'globe' && (
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="9" fill="currentColor" fill-opacity="0.15" />
                          <path d="M3.6 9h16.8M3.6 15h16.8" />
                          <path d="M12 3a14.5 14.5 0 0 1 0 18M12 3a14.5 14.5 0 0 0 0 18" />
                        </svg>
                      )}
                      {theme.iconPath === 'pin' && (
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M12 2a7 7 0 0 0-7 7c0 5 7 13 7 13s7-8 7-13a7 7 0 0 0-7-7z" fill="currentColor" fill-opacity="0.2" />
                          <circle cx="12" cy="9" r="2.5" />
                        </svg>
                      )}
                      {theme.iconPath === 'code' && (
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <rect x="3" y="4" width="18" height="16" rx="3" fill="currentColor" fill-opacity="0.15" />
                          <path d="M8 10l-2 2 2 2M16 10l2 2-2 2M13 9l-2 6" />
                        </svg>
                      )}
                      {theme.iconPath === 'scatter' && (
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M3 3v18h18" />
                          <circle cx="8" cy="15" r="1.5" fill="currentColor" />
                          <circle cx="11" cy="9" r="1.5" fill="currentColor" />
                          <circle cx="14" cy="13" r="1.5" fill="currentColor" />
                          <circle cx="17" cy="7" r="1.5" fill="currentColor" />
                          <path d="M6 16c2-4 4-8 7-8s5 5 7 9" stroke-dasharray="2 2" />
                        </svg>
                      )}
                      {theme.iconPath === 'brain' && (
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="6" cy="6" r="2" fill="currentColor" />
                          <circle cx="6" cy="18" r="2" fill="currentColor" />
                          <circle cx="18" cy="12" r="2" fill="currentColor" />
                          <circle cx="12" cy="6" r="1.5" />
                          <circle cx="12" cy="18" r="1.5" />
                          <path d="M8 6h2M8 18h2M13.5 7l2.5 3.5M13.5 17l2.5-3.5M7.5 7.5l9 4M7.5 16.5l9-4" />
                        </svg>
                      )}
                    </div>

                    {/* Main Project Details */}
                    <div class="flex-1 min-w-0">
                      {/* Top Badges */}
                      <div class="flex flex-wrap items-center gap-2 mb-1.5">
                        <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] sm:text-[11px] font-bold uppercase tracking-wider border ${theme.badgeStyle}`}>
                          <span class="h-1.5 w-1.5 rounded-full bg-current animate-pulse"></span>
                          {theme.tag}
                        </span>
                        <span class="text-[11px] font-semibold text-muted-foreground">
                          {theme.domainLabel}
                        </span>
                      </div>

                      {/* Bigger Project Name */}
                      <h4 class="text-base sm:text-lg lg:text-xl font-extrabold text-foreground tracking-tight leading-snug">
                        {mod.practicalProject}
                      </h4>

                      {/* Brief Explanation */}
                      <p class="text-xs sm:text-[13px] text-muted-foreground leading-relaxed mt-1.5 font-medium">
                        {theme.brief}
                      </p>

                      {/* Deliverables Chips */}
                      <div class="flex flex-wrap items-center gap-1.5 mt-3 pt-3 border-t border-border/40">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-muted-foreground/80 mr-1">
                          Key Deliverables:
                        </span>
                        {theme.deliverables.map((item) => (
                          <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-background/85 text-[11px] font-semibold text-foreground border border-border/60 shadow-2xs">
                            {item}
                          </span>
                        ))}
                      </div>
                    </div>
                  </div>
                </div>

                {/* ── Notes (if any) ── */}
                {mod.notes && mod.notes.length > 0 && (
                  <div class="module-content-anim mt-3 rounded-lg border border-amber-500/20 bg-amber-500/5 p-3 text-xs text-amber-700 dark:text-amber-400 font-medium">
                    {mod.notes.join(' ')}
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</div>

<style>
  /* ── Reduced motion compliance ── */
  @media (prefers-reduced-motion: reduce) {
    .curriculum-accordion-root .module-panel,
    .curriculum-accordion-root .chevron-icon,
    .topic-pill,
    .tech-card,
    .module-content-anim {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }

  /* ── Chevron rotation when open ── */
  .module-trigger[aria-expanded="true"] .chevron-icon {
    transform: rotate(180deg);
  }

  /* ── Number badge brand highlight when open ── */
  .module-trigger[aria-expanded="true"] .module-number-badge {
    background-color: var(--color-brand, #e60023);
    color: #ffffff;
  }

  /* ── Stagger animation for panel content ── */
  @keyframes fadeSlideUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Topic pills and tech cards staggered entrance */
  .module-panel[style*="1fr"] .topic-pill,
  .module-panel[style*="1fr"] .tech-card {
    animation: fadeSlideUp 0.35s ease-out both;
  }

  .module-panel[style*="1fr"] .module-content-anim {
    animation: fadeSlideUp 0.4s ease-out both;
  }

  .module-panel[style*="1fr"] .module-content-anim:nth-child(1) { animation-delay: 0ms; }
  .module-panel[style*="1fr"] .module-content-anim:nth-child(2) { animation-delay: 80ms; }
  .module-panel[style*="1fr"] .module-content-anim:nth-child(3) { animation-delay: 160ms; }
  .module-panel[style*="1fr"] .module-content-anim:nth-child(4) { animation-delay: 220ms; }

  /* ── Module item open state subtle left accent ── */
  .module-item:has(.module-trigger[aria-expanded="true"]) {
    border-left: 3px solid var(--color-brand, #e60023);
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById('curriculum-accordion');
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = 'true';

    const triggers = Array.from(root.querySelectorAll('.module-trigger'));
    const collapseAllBtn = document.getElementById('accordion-collapse-all');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function closeModule(trigger) {
      const panelId = trigger.getAttribute('aria-controls');
      const panel = document.getElementById(panelId);
      if (!panel) return;
      trigger.setAttribute('aria-expanded', 'false');
      panel.style.gridTemplateRows = '0fr';
    }

    function openModule(trigger) {
      const panelId = trigger.getAttribute('aria-controls');
      const panel = document.getElementById(panelId);
      if (!panel) return;
      trigger.setAttribute('aria-expanded', 'true');
      panel.style.gridTemplateRows = '1fr';
    }

    function handleModuleClick(trigger) {
      const isCurrentlyOpen = trigger.getAttribute('aria-expanded') === 'true';

      if (isCurrentlyOpen) {
        closeModule(trigger);
        return;
      }

      // Close all other modules — single-focus accordion
      triggers.forEach((other) => {
        if (other !== trigger) {
          closeModule(other);
        }
      });

      // Expand the clicked module
      openModule(trigger);

      // Scroll the module into comfortable view
      const moduleItem = trigger.closest('.module-item');
      if (moduleItem) {
        setTimeout(() => {
          moduleItem.scrollIntoView({
            behavior: prefersReducedMotion ? 'auto' : 'smooth',
            block: 'start',
          });
        }, 60);
      }
    }

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => handleModuleClick(trigger));

      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleModuleClick(trigger);
        }
      });
    });

    if (collapseAllBtn) {
      collapseAllBtn.addEventListener('click', () => {
        triggers.forEach((t) => closeModule(t));
      });
    }

    // Hash deep-link support
    const hash = window.location.hash;
    if (hash && hash.startsWith('#module-')) {
      const targetPanel = document.querySelector(hash);
      if (targetPanel) {
        const targetTrigger = root.querySelector(`[aria-controls="${targetPanel.id}"]`);
        if (targetTrigger) {
          handleModuleClick(targetTrigger);
        }
      }
    }
  })();
</script>
