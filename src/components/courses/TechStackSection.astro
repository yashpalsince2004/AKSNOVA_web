---
import type { TechStackCategory } from '@/data/courses/data-science';

interface Props {
  techStack: TechStackCategory[];
  note: string;
}

const { techStack, note } = Astro.props;
---

<section id="tech-stack" class="scroll-mt-24">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10">
    <div class="max-w-2xl">
      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase bg-brand/10 text-brand mb-3">
        Industry Tooling & Ecosystem
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-foreground">
        Software & Technology Stack
      </h2>
      <p class="mt-2 text-sm sm:text-base text-muted-foreground leading-relaxed">
        Comprehensive hands-on exposure across the full lifecycle of data manipulation, business intelligence, machine learning, and automation.
      </p>
    </div>

    <div class="text-xs text-muted-foreground bg-secondary/60 rounded-xl px-4 py-2 border border-border/60 max-w-sm">
      <span class="font-bold text-foreground">Curriculum Note:</span> {note}
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {techStack.map((category) => (
      <div class="rounded-2xl border border-border bg-card p-6 flex flex-col justify-between transition-all hover:border-brand/30 hover:shadow-sm">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <h3 class="text-base font-bold text-foreground">
              {category.category}
            </h3>
            <span class="text-xs font-bold text-muted-foreground">
              {category.technologies.length} Tools
            </span>
          </div>

          <p class="text-xs text-muted-foreground leading-relaxed mb-5">
            {category.description}
          </p>
        </div>

        <div class="pt-4 border-t border-border/60 flex flex-wrap gap-2">
          {category.technologies.map((tech) => (
            <span class="inline-flex items-center rounded-xl border border-border/80 bg-background px-3 py-1.5 text-xs font-semibold text-foreground transition-colors hover:border-brand/50 hover:bg-secondary">
              {tech}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>
