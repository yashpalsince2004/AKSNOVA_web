---
import type { CourseData } from '@/data/courses/data-science';
import { withBase } from '@/lib/paths';

interface Props {
  course: CourseData;
}

const { course } = Astro.props;
---

<header id="overview" class="pt-4 pb-12 sm:pb-16 border-b border-border">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <!-- Left Column: Copy & CTAs (7 Cols) -->
    <div class="lg:col-span-7 space-y-6">
      <div class="flex flex-wrap items-center gap-2.5">
        <span class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold tracking-wide uppercase bg-brand text-primary-foreground">
          {course.badge}
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-secondary text-foreground">
          {course.highlights.duration}
        </span>
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-secondary text-foreground">
          {course.highlights.liveLearning}
        </span>
      </div>

      <h1 class="text-3xl sm:text-5xl lg:text-[54px] font-extrabold tracking-tight text-foreground leading-[1.08] lg:-tracking-[1.2px]">
        {course.title}
      </h1>

      <p class="text-base sm:text-lg text-muted-foreground leading-relaxed max-w-2xl">
        {course.overview}
      </p>

      <!-- Highlights Matrix in 16px radius cards (DESIGN.md specification) -->
      <div id="highlights" class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 scroll-mt-28">
        <div class="rounded-2xl border border-border/80 bg-card p-4 transition-all hover:border-brand/30">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Duration</span>
          <span class="mt-1 block text-base sm:text-lg font-bold text-foreground">{course.highlights.duration}</span>
        </div>
        <div class="rounded-2xl border border-border/80 bg-card p-4 transition-all hover:border-brand/30">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Live Learning</span>
          <span class="mt-1 block text-base sm:text-lg font-bold text-foreground">{course.highlights.liveLearning}</span>
        </div>
        <div class="rounded-2xl border border-border/80 bg-card p-4 transition-all hover:border-brand/30">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Practical Ratio</span>
          <span class="mt-1 block text-base sm:text-lg font-bold text-brand">~80% Practical</span>
        </div>
        <div class="rounded-2xl border border-border/80 bg-card p-4 transition-all hover:border-brand/30">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Project Exposure</span>
          <span class="mt-1 block text-base sm:text-lg font-bold text-foreground">30+ Projects</span>
        </div>
        <div class="rounded-2xl border border-border/80 bg-card p-4 transition-all hover:border-brand/30">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Format</span>
          <span class="mt-1 block text-base sm:text-lg font-bold text-foreground">Interactive Live</span>
        </div>
        <div class="rounded-2xl border border-border/80 bg-card p-4 transition-all hover:border-brand/30">
          <span class="block text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Career Support</span>
          <span class="mt-1 block text-base sm:text-lg font-bold text-brand">Internship Advertised</span>
        </div>
      </div>

      <!-- Action CTAs -->
      <div class="flex flex-wrap items-center gap-3.5 pt-2">
        <a
          href={withBase('/contact')}
          class="inline-flex h-12 items-center justify-center rounded-2xl bg-brand px-7 text-sm font-bold text-primary-foreground shadow-md transition-all hover:bg-brand-deep hover:shadow-lg active:scale-95"
        >
          Talk to a Career Counsellor
        </a>
        <a
          href="#curriculum"
          class="inline-flex h-12 items-center justify-center rounded-2xl border border-border/80 bg-secondary px-6 text-sm font-bold text-foreground transition-all hover:bg-accent active:scale-95"
        >
          Explore All 7 Modules
        </a>
      </div>
    </div>

    <!-- Right Column: Visual Card with Pin Geometry (5 Cols) -->
    <div class="lg:col-span-5 flex justify-center">
      <div class="relative w-full max-w-md lg:max-w-none rounded-[32px] border border-border overflow-hidden bg-card shadow-xl">
        <!-- Visual Image -->
        <div class="relative h-[320px] sm:h-[400px] overflow-hidden">
          <img
            src={withBase('/images/courses/datascience.jpg')}
            alt="Data Science and Artificial Intelligence Master Program"
            width="1024"
            height="640"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-105"
            loading="eager"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent"></div>

          <!-- Signature Pin-Overlay-Pills (DESIGN.md component) -->
          <div class="absolute top-4 left-4 flex flex-col gap-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/95 text-zinc-950 text-xs font-bold shadow-md backdrop-blur-xs">
              <span class="h-2 w-2 rounded-full bg-brand"></span>
              7 Core Domains
            </span>
          </div>

          <div class="absolute top-4 right-4">
            <span class="inline-flex items-center px-3 py-1 rounded-full bg-black/70 text-white text-xs font-semibold backdrop-blur-xs border border-white/20">
              Live Mentorship
            </span>
          </div>

          <!-- Bottom Card Content Overlay -->
          <div class="absolute inset-x-6 bottom-6 text-white space-y-2">
            <div class="text-[11px] font-bold uppercase tracking-wider text-white/80">
              Pedagogical Progression
            </div>
            <h3 class="text-lg font-bold text-white leading-tight">
              Excel &rarr; SQL &rarr; Power BI &rarr; Tableau &rarr; Python &rarr; ML &rarr; AI BI
            </h3>
            <p class="text-xs text-white/80 leading-relaxed">
              From descriptive spreadsheet metrics to automated predictive models and business dashboards.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>
