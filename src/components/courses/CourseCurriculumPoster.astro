---
import TechLogo from './TechLogo.astro';

interface Props {
  totalModules?: number;
  totalProjects?: number;
}

const { totalModules = 7, totalProjects = 7 } = Astro.props;

const corePillars = [
  { name: 'Python & AI Logic', level: '95%', color: 'from-blue-500 to-indigo-500' },
  { name: 'SQL & Database Architecture', level: '90%', color: 'from-cyan-500 to-blue-500' },
  { name: 'Power BI & Tableau BI', level: '92%', color: 'from-amber-500 to-orange-500' },
  { name: 'Exploratory Data Analytics', level: '88%', color: 'from-teal-500 to-emerald-500' },
  { name: 'Predictive Machine Learning', level: '85%', color: 'from-purple-500 to-pink-500' },
];

const quickModules = [
  { num: '01', title: 'Excel Analytics', color: 'text-emerald-500 dark:text-emerald-400' },
  { num: '02', title: 'SQL & Databases', color: 'text-blue-500 dark:text-blue-400' },
  { num: '03', title: 'Power BI Storytelling', color: 'text-amber-500 dark:text-amber-400' },
  { num: '04', title: 'Tableau Visuals', color: 'text-rose-500 dark:text-rose-400' },
  { num: '05', title: 'Python Automation', color: 'text-indigo-500 dark:text-indigo-400' },
  { num: '06', title: 'Pandas & Seaborn EDA', color: 'text-teal-500 dark:text-teal-400' },
  { num: '07', title: 'Machine Learning & AI', color: 'text-purple-500 dark:text-purple-400' },
];
---

<aside class="curriculum-poster-root relative rounded-3xl border border-border/80 bg-card/90 backdrop-blur-xl shadow-xl overflow-hidden transition-all duration-300 hover:border-brand/40">
  {/* ── Ambient Glow Background Elements ── */}
  <div class="absolute -top-24 -left-24 h-56 w-56 rounded-full bg-cyan-500/15 blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 h-56 w-56 rounded-full bg-purple-500/15 blur-3xl pointer-events-none"></div>

  {/* ── 3D Poster Banner Image with Holographic Overlay ── */}
  <div class="relative w-full aspect-[4/3] sm:aspect-[16/10] overflow-hidden bg-slate-950 group/poster">
    <img
      src="/images/courses/data-science-curriculum-poster.jpg"
      alt="Data Science, AI & Business Intelligence Curriculum Visualization Poster"
      class="h-full w-full object-cover object-center transition-transform duration-700 ease-out group-hover/poster:scale-105"
      loading="lazy"
      width="800"
      height="600"
    />

    {/* Luminous Gradient Veil */}
    <div class="absolute inset-0 bg-gradient-to-t from-card via-card/30 to-transparent"></div>

    {/* Scanning Animation Laser Line */}
    <div class="poster-scan-line absolute inset-x-0 h-[2px] bg-gradient-to-r from-transparent via-cyan-400 to-transparent opacity-75"></div>

    {/* Top Floating Badge: Live Lab */}
    <div class="absolute top-3.5 left-3.5 flex items-center gap-2 px-3 py-1.5 rounded-full bg-background/85 backdrop-blur-md border border-white/20 shadow-lg text-[11px] font-bold text-foreground">
      <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-ping"></span>
      <span class="h-2 w-2 rounded-full bg-emerald-500 absolute left-3.5"></span>
      <span>AI & Analytics Studio</span>
    </div>

    {/* Top Right Floating Badge: 100% Practical */}
    <div class="absolute top-3.5 right-3.5 flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-background/85 backdrop-blur-md border border-white/20 shadow-lg text-[11px] font-extrabold text-brand">
      <svg class="h-3.5 w-3.5 text-brand" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
      </svg>
      <span>Hands-On Capstone</span>
    </div>

    {/* Bottom Overlay Info on Poster */}
    <div class="absolute bottom-3 left-4 right-4 flex items-end justify-between gap-2">
      <div>
        <span class="text-[10px] font-black uppercase tracking-wider text-cyan-500 dark:text-cyan-400 drop-shadow-sm">
          Industry Curriculum
        </span>
        <h3 class="text-base sm:text-lg font-black text-foreground drop-shadow-sm leading-tight">
          Master Practical Data & AI
        </h3>
      </div>
      <span class="px-2.5 py-1 rounded-lg bg-card/90 backdrop-blur-md text-[11px] font-bold text-foreground border border-border/80 shrink-0 shadow-xs">
        {totalModules} Modules
      </span>
    </div>
  </div>

  {/* ── Content Body ── */}
  <div class="p-5 sm:p-6 space-y-6">

    {/* ── Animated Quick Metrics Bar ── */}
    <div class="grid grid-cols-2 gap-3">
      <div class="rounded-2xl border border-border/70 bg-secondary/40 p-3.5 flex items-center gap-3 transition-colors hover:border-cyan-500/40">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-cyan-500/15 text-cyan-600 dark:text-cyan-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div>
          <span class="block text-lg font-black text-foreground leading-none">30+</span>
          <span class="text-[11px] font-semibold text-muted-foreground">Real Case Studies</span>
        </div>
      </div>

      <div class="rounded-2xl border border-border/70 bg-secondary/40 p-3.5 flex items-center gap-3 transition-colors hover:border-purple-500/40">
        <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-purple-500/15 text-purple-600 dark:text-purple-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
        </div>
        <div>
          <span class="block text-lg font-black text-foreground leading-none">{totalProjects} Portfolios</span>
          <span class="text-[11px] font-semibold text-muted-foreground">Live Capstones</span>
        </div>
      </div>
    </div>

    {/* ── Key Technical Competency Bars ── */}
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground">
          Core Competency Focus
        </span>
        <span class="text-[11px] font-extrabold text-brand">Practical Depth</span>
      </div>

      <div class="space-y-2.5">
        {corePillars.map((pillar) => (
          <div class="space-y-1">
            <div class="flex items-center justify-between text-xs font-semibold text-foreground">
              <span>{pillar.name}</span>
              <span class="text-[11px] text-muted-foreground">{pillar.level}</span>
            </div>
            <div class="h-1.5 w-full rounded-full bg-secondary overflow-hidden">
              <div
                class={`h-full rounded-full bg-gradient-to-r ${pillar.color} transition-all duration-1000 ease-out`}
                style={`width: ${pillar.level};`}
              ></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* ── Interactive Module Quick Jump ── */}
    <div class="space-y-2.5 pt-2 border-t border-border/60">
      <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground block">
        Syllabus Modules Quick Index
      </span>
      <div class="grid grid-cols-1 gap-1.5" id="poster-module-quick-nav">
        {quickModules.map((qm, i) => (
          <button
            type="button"
            class="poster-quick-btn group flex items-center justify-between px-3 py-2 rounded-xl text-left text-xs font-semibold text-foreground bg-secondary/50 hover:bg-secondary border border-transparent hover:border-border transition-all cursor-pointer"
            data-target-module={`module-${i + 1}`}
          >
            <span class="flex items-center gap-2">
              <span class={`font-black text-[11px] ${qm.color}`}>
                {qm.num}
              </span>
              <span class="group-hover:text-foreground transition-colors truncate max-w-[190px]">
                {qm.title}
              </span>
            </span>
            <svg class="h-3.5 w-3.5 text-muted-foreground group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>
        ))}
      </div>
    </div>

    {/* ── Direct Mentor / Enrollment CTA Pill ── */}
    <div class="rounded-2xl border border-brand/20 bg-brand/5 p-4 text-center space-y-2">
      <span class="inline-flex items-center gap-1.5 text-xs font-extrabold text-foreground">
        <svg class="h-4 w-4 text-brand" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" />
        </svg>
        Ready to Master These Tools?
      </span>
      <p class="text-[11px] text-muted-foreground leading-relaxed">
        Get 1-on-1 mentor guidance, project reviews, and placement assistance.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center justify-center w-full rounded-xl bg-brand hover:bg-brand/90 px-4 py-2.5 text-xs font-bold text-white transition-all shadow-md shadow-brand/20 cursor-pointer"
      >
        Inquire About Syllabus & Batches
      </a>
    </div>

  </div>
</aside>

<style>
  /* ── Scanning line animation ── */
  @keyframes scanSweep {
    0% {
      top: 0%;
      opacity: 0;
    }
    15% {
      opacity: 0.9;
    }
    85% {
      opacity: 0.9;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }

  .poster-scan-line {
    animation: scanSweep 4s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .poster-scan-line {
      display: none;
    }
  }
</style>

<script is:inline>
  (() => {
    // Quick jump clicks: trigger accordion module expansion & smooth scroll
    const quickNav = document.getElementById('poster-module-quick-nav');
    if (!quickNav) return;

    quickNav.querySelectorAll('.poster-quick-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const modId = btn.dataset.targetModule;
        if (!modId) return;

        const headerBtn = document.getElementById(`module-header-${modId}`);
        if (headerBtn) {
          headerBtn.click();
        }
      });
    });
  })();
</script>
