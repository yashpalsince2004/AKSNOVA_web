---
interface Props {
  faqs: {
    question: string;
    answer: string;
  }[];
}

const { faqs } = Astro.props;
---

<section id="faqs" class="scroll-mt-24">
  <div class="max-w-3xl mb-8">
    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold tracking-wide uppercase bg-brand/10 text-brand mb-3">
      Curriculum & Program Clarity
    </span>
    <h2 class="text-3xl sm:text-4xl font-bold tracking-tight text-foreground">
      Frequently Asked Questions
    </h2>
    <p class="mt-2 text-sm sm:text-base text-muted-foreground leading-relaxed">
      Clear answers based strictly on published curriculum and program facts.
    </p>
  </div>

  <div class="space-y-3 max-w-4xl" id="course-faq-accordion">
    {faqs.map((faq, idx) => {
      const qId = `faq-q-${idx}`;
      const aId = `faq-a-${idx}`;
      return (
        <div class="faq-item rounded-2xl border border-border bg-card overflow-hidden transition-all duration-200 hover:border-brand/40">
          <button
            type="button"
            id={qId}
            aria-expanded="false"
            aria-controls={aId}
            class="faq-trigger w-full p-5 sm:p-6 text-left flex items-center justify-between gap-4 cursor-pointer select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand"
          >
            <span class="text-sm sm:text-base font-bold text-foreground">
              {faq.question}
            </span>
            <span class="faq-icon-wrapper flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-secondary text-foreground transition-transform duration-300">
              <svg class="faq-icon h-4 w-4 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </button>

          <div
            id={aId}
            role="region"
            aria-labelledby={qId}
            class="faq-panel grid transition-[grid-template-rows] duration-300 ease-out"
            style="grid-template-rows: 0fr;"
          >
            <div class="overflow-hidden">
              <div class="px-5 pb-6 sm:px-6 sm:pb-6 text-xs sm:text-sm text-muted-foreground leading-relaxed border-t border-border/60 pt-3">
                {faq.answer}
              </div>
            </div>
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .faq-trigger[aria-expanded="true"] .faq-icon {
    transform: rotate(180deg);
  }
</style>

<script is:inline>
  (() => {
    const root = document.getElementById('course-faq-accordion');
    if (!root || root.dataset.initialized) return;
    root.dataset.initialized = 'true';

    const triggers = Array.from(root.querySelectorAll('.faq-trigger'));

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        const panelId = trigger.getAttribute('aria-controls');
        const panel = document.getElementById(panelId);
        if (!panel) return;

        const isOpen = trigger.getAttribute('aria-expanded') === 'true';
        trigger.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
        panel.style.gridTemplateRows = isOpen ? '0fr' : '1fr';
      });

      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          trigger.click();
        }
      });
    });
  })();
</script>
