---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = "h-4 w-4" } = Astro.props;

// Normalise tool name for robust lookup
const cleanName = name.toLowerCase().trim();
---

{
  /* 1. Microsoft Excel / Excel */
  (cleanName.includes('excel')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Microsoft Excel">
      <rect x="3" y="4" width="26" height="24" rx="4" fill="#107C41" />
      <path d="M17 7h10a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H17V7z" fill="#185C37" opacity="0.4" />
      <rect x="5" y="7" width="13" height="18" rx="2.5" fill="#21A366" />
      <path d="M8.5 11.5l3.2 4.5-3.4 4.5h2l2.3-3.2 2.3 3.2h2l-3.4-4.5 3.2-4.5h-2L12.5 14.7 10.5 11.5h-2z" fill="#FFFFFF" font-weight="bold" />
    </svg>
  )
}

{
  /* 2. Python */
  (cleanName === 'python' || cleanName.startsWith('python ') && !cleanName.includes('ide')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Python">
      <path d="M15.8 3C9.5 3 9.9 5.7 9.9 5.7L10 8.5h6v1H6.7S3 9 3 15.3c0 6.2 3.2 6 3.2 6h1.9v-2.8s-.1-3.3 3.3-3.3h5.7s3.2.1 3.2-3.1V6.1S20.8 3 15.8 3zm-2.8 2.2a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2z" fill="#387EB8" />
      <path d="M16.2 29c6.3 0 5.9-2.7 5.9-2.7l-.1-2.8h-6v-1h9.3s3.7.5 3.7-5.8c0-6.2-3.2-6-3.2-6h-1.9v2.8s.1 3.3-3.3 3.3h-5.7s-3.2-.1-3.2 3.1v5.9s-.5 3.2 4.5 3.2zm2.8-2.2a1.1 1.1 0 1 1 0-2.2 1.1 1.1 0 0 1 0 2.2z" fill="#FFE873" />
    </svg>
  )
}

{
  /* 3. SQL / Relational Database */
  (cleanName === 'sql' || cleanName.includes('relational database')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="SQL">
      <ellipse cx="16" cy="7" rx="12" ry="4" fill="#00758F" />
      <path d="M4 7v6c0 2.2 5.4 4 12 4s12-1.8 12-4V7" fill="none" stroke="#00758F" stroke-width="2.5" />
      <path d="M4 13v6c0 2.2 5.4 4 12 4s12-1.8 12-4v-6" fill="none" stroke="#00758F" stroke-width="2.5" />
      <path d="M4 19v6c0 2.2 5.4 4 12 4s12-1.8 12-4v-6" fill="none" stroke="#F29111" stroke-width="2.5" />
      <ellipse cx="16" cy="7" rx="8" ry="2.2" fill="#4DABCF" />
    </svg>
  )
}

{
  /* 4. MySQL / MySQL Workbench */
  (cleanName.includes('mysql')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="MySQL">
      <rect width="32" height="32" rx="6" fill="#00758F" />
      <path d="M25 18.5c-2.3 0-3.6-1.5-4.8-3-.9-1.2-1.9-2.3-3.4-2.5-.2 0-.5 0-.8.1-.9.4-1.3 1.5-1.1 2.5.3 1.3 1.4 2.3 2.7 2.6v1.2c-2.1-.3-3.7-1.8-4.2-3.8-.4-1.8.2-3.6 1.7-4.6 1.4-1 3.2-1 4.7-.2 1.8 1 3 2.8 4.3 4.4.9 1.1 1.7 1.9 2.9 2 0 .5-.7 1.3-2 1.3z" fill="#FFFFFF" />
      <path d="M8 21.5c-1.5 0-2.8-.8-3.4-2.1-.7-1.4-.4-3.1.6-4.2 1.4-1.5 3.6-2.1 5.6-1.4l-.4 1.5c-1.4-.5-3 .1-3.9 1.1-.7.8-.9 1.9-.4 2.8.4.8 1.3 1.4 2.3 1.3l.3 1.5c-.2-.3-.5-.5-.7-.5z" fill="#F29111" />
      <circle cx="17.5" cy="11.5" r="1.2" fill="#F29111" />
    </svg>
  )
}

{
  /* 5. Microsoft Power BI */
  (cleanName.includes('power bi')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Power BI">
      <rect width="32" height="32" rx="6" fill="#201F1E" />
      <rect x="6" y="16" width="5.5" height="10" rx="1.5" fill="#F2C811" />
      <rect x="13.2" y="11" width="5.5" height="15" rx="1.5" fill="#F2C811" />
      <rect x="20.5" y="6" width="5.5" height="20" rx="1.5" fill="#E6AD10" />
      <path d="M20.5 8a2 2 0 0 1 2-2h1.5a2 2 0 0 1 2 2v18h-5.5V8z" fill="#F2C811" opacity="0.9" />
    </svg>
  )
}

{
  /* 6. Power Query */
  (cleanName.includes('power query')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Power Query">
      <rect width="32" height="32" rx="6" fill="#04A9C6" />
      <path d="M9 8h8a5 5 0 0 1 5 5c0 2.2-1.4 4.1-3.4 4.7l3.9 6.3h-3.6l-3.4-5.7H12v5.7H9V8zm3 2.7v5.3h5a2.7 2.7 0 1 0 0-5.3h-5z" fill="#FFFFFF" />
      <circle cx="23" cy="9" r="2.5" fill="#F2C811" />
    </svg>
  )
}

{
  /* 7. Data modeling & DAX / DAX */
  (cleanName.includes('dax') || cleanName.includes('data modeling')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="DAX & Data Modeling">
      <rect width="32" height="32" rx="6" fill="#1B365D" />
      <rect x="5" y="6" width="9" height="7" rx="1.5" fill="#F2C811" />
      <rect x="18" y="6" width="9" height="7" rx="1.5" fill="#0078D4" />
      <rect x="11.5" y="19" width="9" height="7" rx="1.5" fill="#107C41" />
      <path d="M9.5 13v3h13v-3M16 16v3" stroke="#FFFFFF" stroke-width="1.8" stroke-dasharray="1.5 1.5" />
    </svg>
  )
}

{
  /* 8. Tableau Desktop / Tableau Public / Tableau */
  (cleanName.includes('tableau')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Tableau">
      {/* Center cluster */}
      <rect x="14.8" y="10" width="2.4" height="12" rx="0.8" fill="#EB762B" />
      <rect x="10" y="14.8" width="12" height="2.4" rx="0.8" fill="#EB762B" />
      {/* Top arm */}
      <rect x="15.2" y="3" width="1.6" height="6" rx="0.6" fill="#E84A5F" />
      <rect x="13" y="5.2" width="6" height="1.6" rx="0.6" fill="#E84A5F" />
      {/* Bottom arm */}
      <rect x="15.2" y="23" width="1.6" height="6" rx="0.6" fill="#4E79A7" />
      <rect x="13" y="25.2" width="6" height="1.6" rx="0.6" fill="#4E79A7" />
      {/* Left arm */}
      <rect x="3" y="15.2" width="6" height="1.6" rx="0.6" fill="#76B7B2" />
      <rect x="5.2" y="13" width="1.6" height="6" rx="0.6" fill="#76B7B2" />
      {/* Right arm */}
      <rect x="23" y="15.2" width="6" height="1.6" rx="0.6" fill="#F28E2B" />
      <rect x="25.2" y="13" width="1.6" height="6" rx="0.6" fill="#F28E2B" />
      {/* Diagonal dots */}
      <circle cx="8" cy="8" r="1.3" fill="#B07AA1" />
      <circle cx="24" cy="8" r="1.3" fill="#59A14F" />
      <circle cx="8" cy="24" r="1.3" fill="#EDC948" />
      <circle cx="24" cy="24" r="1.3" fill="#FF9DA7" />
    </svg>
  )
}

{
  /* 9. Pandas */
  (cleanName.includes('pandas')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Pandas">
      <rect width="32" height="32" rx="6" fill="#130654" />
      <rect x="8" y="7" width="4.5" height="10" rx="1" fill="#FFD43B" />
      <rect x="8" y="19" width="4.5" height="6" rx="1" fill="#E70488" />
      <rect x="14" y="11" width="4.5" height="14" rx="1" fill="#FFFFFF" />
      <rect x="20" y="7" width="4.5" height="6" rx="1" fill="#18BFFF" />
      <rect x="20" y="15" width="4.5" height="10" rx="1" fill="#FF4500" />
    </svg>
  )
}

{
  /* 10. NumPy */
  (cleanName.includes('numpy')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="NumPy">
      <rect width="32" height="32" rx="6" fill="#013243" />
      <path d="M9 8h3.2l7.8 12.5V8h3v16h-3.2L12 11.5V24H9V8z" fill="#4DABCF" />
      <rect x="13.5" y="14" width="5" height="4" fill="#013243" />
    </svg>
  )
}

{
  /* 11. Matplotlib */
  (cleanName.includes('matplotlib')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Matplotlib">
      <rect width="32" height="32" rx="6" fill="#11557C" />
      <path d="M5 24h22" stroke="#FFFFFF" stroke-width="1.8" />
      <path d="M7 24c2-8 5-14 9-14s7 10 9 14" stroke="#FEC44F" stroke-width="2.5" fill="none" />
      <path d="M7 24c3-4 6-6 9-6s6 3 9 6" stroke="#FF5722" stroke-width="2" fill="none" />
      <circle cx="16" cy="10" r="2" fill="#4CAF50" />
    </svg>
  )
}

{
  /* 12. Seaborn */
  (cleanName.includes('seaborn')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Seaborn">
      <rect width="32" height="32" rx="6" fill="#4C72B0" />
      <path d="M22 8c-6 0-7 5-11 5s-4-2-4-2v4s2 2 4 2 5-5 11-5 4 2 4 2V10s-1-2-4-2z" fill="#55A868" />
      <path d="M22 15c-6 0-7 5-11 5s-4-2-4-2v4s2 2 4 2 5-5 11-5 4 2 4 2v-4s-1-2-4-2z" fill="#FFFFFF" opacity="0.9" />
    </svg>
  )
}

{
  /* 13. Scikit-learn */
  (cleanName.includes('scikit')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Scikit-learn">
      <rect width="32" height="32" rx="6" fill="#202A36" />
      <circle cx="12" cy="16" r="6" fill="#3499CD" opacity="0.85" />
      <circle cx="20" cy="16" r="6" fill="#F89939" opacity="0.85" />
      <ellipse cx="16" cy="16" rx="2" ry="4.5" fill="#FFFFFF" opacity="0.5" />
      <text x="16" y="27" font-size="6.5" font-family="sans-serif" font-weight="900" fill="#F89939" text-anchor="middle">SK</text>
    </svg>
  )
}

{
  /* 14. Jupyter Notebook / Python IDE */
  (cleanName.includes('jupyter') || cleanName.includes('ide')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Jupyter Notebook">
      <ellipse cx="16" cy="7" rx="10" ry="3.5" fill="#F37626" />
      <ellipse cx="16" cy="25" rx="10" ry="3.5" fill="#616161" />
      <circle cx="25" cy="14" r="2" fill="#757575" />
      <circle cx="7" cy="18" r="2" fill="#F37626" />
      <circle cx="24" cy="20" r="1.5" fill="#42A5F5" />
    </svg>
  )
}

{
  /* 15. Airtable */
  (cleanName.includes('airtable')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Airtable">
      <path d="M15.2 4.4a1.8 1.8 0 0 1 1.6 0l10.8 5.4a1 1 0 0 1 0 1.8l-10.8 5.4a1.8 1.8 0 0 1-1.6 0L4.4 11.6a1 1 0 0 1 0-1.8L15.2 4.4z" fill="#FCB400" />
      <path d="M14.7 18.2v9.3a1 1 0 0 1-1.4.9L4.6 23.9a1 1 0 0 1-.6-.9v-9.3l10.7 4.5z" fill="#18BFFF" />
      <path d="M17.3 18.2l10.7-4.5v9.3a1 1 0 0 1-.6.9l-8.7 4.5a1 1 0 0 1-1.4-.9v-9.3z" fill="#ED365E" />
    </svg>
  )
}

{
  /* 16. Git */
  (cleanName.includes('git') && !cleanName.includes('assistant')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Git">
      <rect x="16" y="2" width="19" height="19" rx="3.5" transform="rotate(45 16 2)" fill="#F05032" />
      <circle cx="12" cy="16" r="2.2" fill="#FFFFFF" />
      <circle cx="20" cy="12" r="2.2" fill="#FFFFFF" />
      <circle cx="20" cy="20" r="2.2" fill="#FFFFFF" />
      <path d="M12 16h3.5a2 2 0 0 0 2-2v-2M17.5 16v4" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" />
    </svg>
  )
}

{
  /* 17. BeautifulSoup */
  (cleanName.includes('beautifulsoup') || cleanName.includes('soup')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="BeautifulSoup">
      <rect width="32" height="32" rx="6" fill="#2ECC71" />
      <path d="M6 16c0 6 4.5 10 10 10s10-4 10-10H6z" fill="#27AE60" />
      <path d="M11 11c1-2 2-3 2-5M16 11c1-2 2-3 2-5M21 11c1-2 2-3 2-5" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" />
      <path d="M13 18l-3 3 3 3M19 18l3 3-3 3" stroke="#FFFFFF" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}

{
  /* 18. Regular Expressions / Regex */
  (cleanName.includes('regular expression') || cleanName.includes('regex')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Regular Expressions">
      <rect width="32" height="32" rx="6" fill="#8E44AD" />
      <circle cx="11" cy="20" r="2" fill="#00E5FF" />
      <path d="M18 13l4 4M22 13l-4 4M20 11v8" stroke="#FFE600" stroke-width="2" stroke-linecap="round" />
    </svg>
  )
}

{
  /* 19. AI coding assistants / AI assistants */
  (cleanName.includes('ai') || cleanName.includes('assistant')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="AI Assistants">
      <rect width="32" height="32" rx="6" fill="url(#ai-bg-grad)" />
      {/* 4-point glowing star */}
      <path d="M16 5c.5 4.5 4.5 8.5 9 9-4.5.5-8.5 4.5-9 9-.5-4.5-4.5-8.5-9-9 4.5-.5 8.5-4.5 9-9z" fill="url(#ai-star-grad)" />
      <circle cx="23" cy="8" r="2" fill="#38BDF8" />
      <circle cx="8" cy="22" r="1.5" fill="#F472B6" />
      <defs>
        <linearGradient id="ai-bg-grad" x1="0" y1="0" x2="32" y2="32" gradientUnits="userSpaceOnUse">
          <stop stop-color="#312E81" />
          <stop offset="1" stop-color="#1E1B4B" />
        </linearGradient>
        <linearGradient id="ai-star-grad" x1="7" y1="5" x2="25" y2="23" gradientUnits="userSpaceOnUse">
          <stop stop-color="#38BDF8" />
          <stop offset="0.5" stop-color="#A855F7" />
          <stop offset="1" stop-color="#EC4899" />
        </linearGradient>
      </defs>
    </svg>
  )
}

{
  /* Fallback for any other tools */
  (!cleanName.includes('excel') &&
   !cleanName.includes('python') &&
   !cleanName.includes('sql') &&
   !cleanName.includes('mysql') &&
   !cleanName.includes('power bi') &&
   !cleanName.includes('power query') &&
   !cleanName.includes('dax') &&
   !cleanName.includes('data modeling') &&
   !cleanName.includes('tableau') &&
   !cleanName.includes('pandas') &&
   !cleanName.includes('numpy') &&
   !cleanName.includes('matplotlib') &&
   !cleanName.includes('seaborn') &&
   !cleanName.includes('scikit') &&
   !cleanName.includes('jupyter') &&
   !cleanName.includes('ide') &&
   !cleanName.includes('airtable') &&
   !cleanName.includes('git') &&
   !cleanName.includes('beautifulsoup') &&
   !cleanName.includes('soup') &&
   !cleanName.includes('regular expression') &&
   !cleanName.includes('regex') &&
   !cleanName.includes('ai') &&
   !cleanName.includes('assistant')) && (
    <svg class={className} viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label={name}>
      <rect width="32" height="32" rx="6" fill="#334155" />
      <path d="M12 11l-5 5 5 5M20 11l5 5-5 5M18 10l-4 12" stroke="#38BDF8" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
