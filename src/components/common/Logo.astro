---
import { withBase } from '@/lib/paths';

interface Props {
  class?: string;
  showText?: boolean;
}

const { class: className = 'h-8 sm:h-9', showText = true } = Astro.props;
---

<div class="flex items-center">
  {showText ? (
    <>
      <!-- Brand logo from verified identity mockup (light theme) -->
      <img
        src={withBase('/logos/logo-light.png')}
        alt="AKSNOVA"
        width="159"
        height="36"
        class={`${className} w-auto dark:hidden logo-img object-contain shrink-0`}
        loading="eager"
      />
      <!-- Brand logo from verified identity mockup (dark theme) -->
      <img
        src={withBase('/logos/logo-dark.png')}
        alt="AKSNOVA"
        width="159"
        height="36"
        class={`${className} hidden w-auto dark:block logo-img object-contain shrink-0`}
        loading="eager"
      />
    </>
  ) : (
    <>
      <!-- Emblem-only fallback -->
      <img
        src={withBase('/logos/aksnova-icon-light.svg')}
        alt="AKSNOVA logo"
        width="38"
        height="38"
        class={`${className} w-auto dark:hidden logo-img object-contain shrink-0`}
        loading="eager"
      />
      <img
        src={withBase('/logos/aksnova-icon-dark.svg')}
        alt="AKSNOVA logo"
        width="38"
        height="38"
        class={`${className} hidden w-auto dark:block logo-img object-contain shrink-0`}
        loading="eager"
      />
    </>
  )}
</div>
