---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { withBase } from '@/lib/paths';

const pathname = Astro.url.pathname;

const rawNavLinks = [
  { label: 'Courses', href: '/courses' },
  { label: 'Journey', href: '/#journey' },
  { label: 'About', href: '/about' },
  { label: 'Placements', href: '/placements' },
  { label: 'Insights', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];

const navLinks = rawNavLinks.map((link) => ({
  ...link,
  href: withBase(link.href),
  rawHref: link.href,
}));

function isActive(link: typeof navLinks[0]): boolean {
  const target = link.href;
  if (link.rawHref === '/') return pathname === target || pathname === `${target}/`;
  if (link.rawHref.startsWith('/#')) return false;
  return pathname.startsWith(target);
}
---

<header class="sticky top-0 z-50 bg-background/95 backdrop-blur-md border-b border-border/50">
  <!-- Announcement Banner -->
  <div class="bg-brand py-2 text-center text-xs font-semibold tracking-wide text-primary-foreground">
    New batches starting this month — <a href={withBase('/contact')} class="underline underline-offset-2 hover:opacity-90">Book free counselling</a>
  </div>

  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 sm:px-6">
    <a href={withBase('/')} aria-label="AKSNOVA Edutech Homepage" class="transition-transform hover:scale-[1.02]">
      <Logo />
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Main Navigation">
      {navLinks.map((item) => {
        const active = isActive(item);
        return (
          <a
            href={item.href}
            class={`text-sm rounded-full px-3.5 py-2 font-semibold transition-colors ${
              active
                ? 'text-brand bg-brand/10'
                : 'text-foreground hover:bg-secondary'
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <!-- Header Actions -->
    <div class="flex items-center gap-3">
      <div class="hidden sm:block">
        <ThemeToggle />
      </div>

      <a
        href={withBase('/resume-builder')}
        class="hidden h-10 items-center rounded-2xl bg-secondary px-4 text-sm font-bold text-foreground transition hover:bg-accent md:inline-flex"
      >
        Resume Builder
      </a>

      <a
        href={withBase('/contact')}
        class="hidden h-10 items-center rounded-2xl bg-brand px-4 text-sm font-bold text-primary-foreground transition hover:bg-brand-deep md:inline-flex"
      >
        Enquire now
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        class="lg:hidden rounded-xl p-2 text-foreground hover:bg-secondary transition"
      >
        <svg id="menu-icon-open" class="h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="menu-icon-close" class="hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden border-t border-border px-6 py-5 lg:hidden bg-background">
    <nav class="flex flex-col space-y-1" aria-label="Mobile Navigation">
      {navLinks.map((item) => (
        <a
          href={item.href}
          class={`block py-2.5 px-3 rounded-xl font-semibold text-base transition-colors ${
            isActive(item) ? 'text-brand bg-brand/10' : 'text-foreground hover:bg-secondary'
          }`}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="mt-4 flex flex-col gap-2.5 pt-4 border-t border-border">
      <a
        href={withBase('/resume-builder')}
        class="flex h-11 items-center justify-center rounded-2xl bg-secondary text-sm font-bold text-foreground"
      >
        Resume Builder
      </a>
      <a
        href={withBase('/contact')}
        class="flex h-11 items-center justify-center rounded-2xl bg-brand text-sm font-bold text-primary-foreground"
      >
        Book Free Counselling
      </a>
      <div class="mt-2 flex justify-center sm:hidden">
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (menuBtn && menu) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
    });

    // Close menu when clicking links
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      });
    });
  }
</script>
