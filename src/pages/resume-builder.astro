---
import Logo from '@/components/common/Logo.astro';
import ResumeBuilderApp from '@/components/onboarding/ResumeBuilderApp.tsx';
import { withBase } from '@/lib/paths';
import '@/styles/global.css';

const steps = ['Upload', 'Review Profile', 'Preferences'];
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Resume Builder | Master Resume Intake | AKSNOVA Edutech</title>
    <meta name="description" content="Upload or paste your existing resume. AKSNOVA's Resume Builder parses your skills, projects, and work history for mentor review." />
    <meta name="robots" content="noindex, follow" />
    <link rel="canonical" href="https://aksnova.in/resume-builder" />
    <meta property="og:image" content="https://aksnova.in/images/hero.jpg" />
    <link rel="icon" type="image/png" href={withBase('/favicon.png')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script is:inline>
      try {
        const t = localStorage.getItem('theme') || 'dark';
        const d = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.classList.toggle('dark', d);
      } catch (e) {}
    </script>
  </head>
  <body class="min-h-screen bg-background text-foreground flex flex-col">
    <!-- Onboarding Header -->
    <header class="border-b border-border bg-background/95 backdrop-blur">
      <div class="mx-auto flex h-20 max-w-[1140px] items-center justify-between gap-4 px-4 md:px-6">
        <div class="flex items-center gap-3">
          <a href={withBase('/')} aria-label="AKSNOVA Edutech home">
            <Logo />
          </a>
          <span class="hidden rounded-full bg-rb-soft px-2.5 py-0.5 text-xs font-semibold text-rb sm:inline">
            Onboarding
          </span>
        </div>

        <ol class="hidden items-center gap-2 text-sm md:flex">
          {steps.map((s, i) => (
            <li class="flex items-center gap-2">
              <span
                class={`flex h-6 w-6 items-center justify-center rounded-full text-xs font-semibold ${
                  i === 0 ? 'bg-rb text-primary-foreground' : 'bg-secondary text-muted-foreground'
                }`}
              >
                {i + 1}
              </span>
              <span class={i === 0 ? 'font-semibold text-foreground' : 'text-muted-foreground'}>
                {s}
              </span>
              {i < steps.length - 1 && (
                <svg class="h-4 w-4 text-muted-foreground" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              )}
            </li>
          ))}
        </ol>

        <a href={withBase('/')} class="text-sm font-semibold text-muted-foreground transition hover:text-foreground">
          Back to main site
        </a>
      </div>
    </header>

    <!-- Main Container -->
    <main class="mx-auto max-w-[740px] flex-1 px-4 py-12 md:py-16 w-full">
      <p class="rise text-xs font-bold uppercase tracking-wider text-rb">
        Step 1 of 3 · Candidate Profile
      </p>

      <h1 class="rise mt-3 text-3xl sm:text-4xl font-bold leading-tight tracking-[-0.5px] text-foreground">
        Start with your master resume
      </h1>

      <p class="rise mt-3 text-base text-muted-foreground leading-relaxed">
        Give us your existing resume and we will do the heavy lifting — we will parse your experience, projects, and technologies so you can review and tailor them next.
      </p>

      <div class="rise mt-8 rounded-[28px] border border-border bg-card p-6 md:p-8 shadow-sm">
        <ResumeBuilderApp client:load />
      </div>
    </main>

    <!-- Footer note -->
    <footer class="border-t border-border py-6 text-center text-xs text-muted-foreground">
      © {new Date().getFullYear()} AKSNOVA Edutech Resume Acceleration Platform.
    </footer>
  </body>
</html>
