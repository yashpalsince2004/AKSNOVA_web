---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import ContactForm from '@/components/forms/ContactForm.tsx';

const contactDetails = [
  {
    label: 'Call us',
    value: '+91 00000 00000',
    icon: `<svg class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>`,
  },
  {
    label: 'Email us',
    value: 'hello@aksnova.in',
    icon: `<svg class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  },
  {
    label: 'Visit institute',
    value: 'AKSNOVA Training Center, Mumbai, India',
    icon: `<svg class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>`,
  },
  {
    label: 'Office hours',
    value: 'Mon–Sat, 9:00 AM – 7:00 PM',
    icon: `<svg class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
];
---

<BaseLayout
  title="Contact Us | Book Free Career Counselling | AKSNOVA"
  description="Book a free career counselling session with AKSNOVA Edutech. Call, email, or send an enquiry and our mentor will get in touch."
  canonical="/contact"
>
  <div class="mx-auto max-w-7xl px-4 py-8 md:px-6">
    <Breadcrumbs items={[{ name: 'Contact Us', url: '/contact' }]} />

    <!-- Hero -->
    <header class="mt-8 border-b border-border pb-14">
      <p class="eyebrow rise">Contact AKSNOVA</p>
      <h1 class="rise mt-4 max-w-3xl text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight leading-[1.05] text-foreground">
        Let's plan <span class="text-brand">your next step.</span>
      </h1>
      <p class="rise mt-5 max-w-2xl text-lg text-muted-foreground leading-relaxed">
        Book a free counselling session. Tell us your goals and we will recommend the right program, batch schedule, and learning mode for you.
      </p>
    </header>

    <!-- Main Contact Grid -->
    <div class="py-16 grid gap-16 lg:grid-cols-2 items-start">
      <!-- Contact Details -->
      <div>
        <p class="eyebrow">Direct Contact</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-foreground">
          Talk to a real academic counsellor
        </h2>
        <p class="mt-3 text-muted-foreground text-sm sm:text-base leading-relaxed">
          No automated bots, no high-pressure sales calls. Our academic counsellors assess your background and recommend the appropriate path.
        </p>

        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {contactDetails.map(({ label, value, icon }) => (
            <div class="rounded-2xl bg-card border border-border p-6 flex flex-col justify-between">
              <span set:html={icon} />
              <div class="mt-4">
                <span class="text-xs font-bold uppercase tracking-wider text-muted-foreground">{label}</span>
                <p class="mt-1 font-bold text-foreground text-sm">{value}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Interactive Contact Form Island -->
      <div class="rounded-[28px] bg-card border border-border p-6 sm:p-10 shadow-lg">
        <h3 class="text-2xl font-bold text-foreground mb-1">Request a Callback</h3>
        <p class="text-xs sm:text-sm text-muted-foreground mb-6">
          Fill in your details below and a counsellor will reach out within 2 hours.
        </p>
        <ContactForm client:load />
      </div>
    </div>

    <!-- Walk-in Banner -->
    <section class="rounded-[32px] bg-card border border-border p-8 sm:p-12 md:p-14 text-center my-8">
      <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground">
        Prefer to walk in and inspect the facilities?
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-muted-foreground text-sm sm:text-base">
        Drop by our training campus any working day between 9:00 AM and 7:00 PM. Our counsellors will give you a tour of the coding labs, classroom batches, and library facilities.
      </p>
      <div class="mt-6 flex justify-center">
        <a
          href="tel:+910000000000"
          class="inline-flex h-12 items-center gap-2 rounded-2xl bg-secondary px-6 text-sm font-bold text-foreground transition hover:bg-accent"
        >
          <svg class="h-4 w-4 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call For Directions
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
