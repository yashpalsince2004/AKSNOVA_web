---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import PlacementNetwork from '@/components/home/PlacementNetwork.astro';
import { stories } from '@/components/home/StudentStories.astro';

const supportSteps = [
  {
    title: 'Resume & portfolio optimization',
    desc: 'One-on-one sessions to transform your project work into an ATS-friendly resume that technical recruiters actually read.',
    icon: `<svg class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>`,
  },
  {
    title: 'Technical & HR mock interviews',
    desc: 'Live technical rounds, algorithm walkthroughs, and HR behavioural simulations with feedback until the real interview feels familiar.',
    icon: `<svg class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>`,
  },
  {
    title: 'Internship opportunities',
    desc: 'Practical internships that add verified production deliverables and real work credentials to your profile.',
    icon: `<svg class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>`,
  },
  {
    title: 'Direct interview referrals',
    desc: 'Direct job drives and interview scheduling through our established network of 250+ tech companies and corporate hiring partners.',
    icon: `<svg class="h-6 w-6 text-brand" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`,
  },
];

const placementStats = [
  ['250+', 'Hiring partners'],
  ['92%', 'Placement assistance rate'],
  ['3 weeks', 'Median time to first interview'],
  ['100%', 'Students receive 1-on-1 prep'],
];
---

<BaseLayout
  title="Placements & Hiring Network | AKSNOVA Edutech"
  description="Placement assistance at AKSNOVA: resume reviews, mock interviews, internship opportunities, and direct interview scheduling with 250+ hiring partners."
  canonical="/placements"
>
  <div class="mx-auto max-w-7xl px-4 py-8 md:px-6">
    <Breadcrumbs items={[{ name: 'Placements', url: '/placements' }]} />

    <!-- Hero -->
    <header class="mt-8 border-b border-border pb-16">
      <p class="eyebrow rise">Career Placements</p>
      <h1 class="rise mt-4 max-w-4xl text-4xl sm:text-5xl md:text-7xl font-extrabold tracking-tight leading-[1.05] text-foreground">
        Training isn't finished until <span class="text-brand">you're hired.</span>
      </h1>
      <p class="rise mt-6 max-w-2xl text-lg text-muted-foreground leading-relaxed">
        Placement assistance is engineered directly into every program — from your very first project milestone to your final salary negotiation.
      </p>
    </header>

    <!-- Placement Statistics -->
    <section class="grid grid-cols-2 md:grid-cols-4 border-b border-border py-12 gap-6 md:gap-0 md:divide-x md:divide-border">
      {placementStats.map(([num, label]) => (
        <div class="md:px-8">
          <div class="text-4xl sm:text-5xl font-extrabold text-brand tracking-tight">
            {num}
          </div>
          <div class="mt-2 text-sm text-muted-foreground font-medium">
            {label}
          </div>
        </div>
      ))}
    </section>

    <!-- Step by Step Placement Process -->
    <section class="py-20">
      <div class="max-w-2xl">
        <p class="eyebrow">Placement Framework</p>
        <h2 class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight text-foreground">
          What you get, step by step
        </h2>
        <p class="mt-3 text-muted-foreground">
          A dedicated placement acceleration track runs concurrently alongside your course.
        </p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {supportSteps.map(({ title, desc, icon }, i) => (
          <div class="relative rounded-2xl bg-card border border-border p-6 flex flex-col justify-between transition hover:border-brand/40">
            <div>
              <span class="text-xs font-bold text-muted-foreground">0{i + 1}</span>
              <div class="mt-4"><span set:html={icon} /></div>
              <h3 class="mt-4 text-lg font-bold text-foreground">{title}</h3>
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed">{desc}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Guarantees checkmarks -->
      <div class="mt-10 flex flex-wrap gap-6 text-sm text-muted-foreground border-t border-border pt-6">
        <span class="flex items-center gap-2">
          <svg class="h-4 w-4 text-brand shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          Zero placement fees
        </span>
        <span class="flex items-center gap-2">
          <svg class="h-4 w-4 text-brand shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          Support continues after graduation
        </span>
        <span class="flex items-center gap-2">
          <svg class="h-4 w-4 text-brand shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
          Dedicated drives for both IT and Non-IT tracks
        </span>
      </div>
    </section>
  </div>

  <!-- Continuous Placement Network Marquee -->
  <PlacementNetwork />

  <!-- Alumni Testimonials -->
  <div class="mx-auto max-w-7xl px-4 py-16 md:px-6">
    <div class="max-w-2xl">
      <p class="eyebrow">Alumni Success</p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-foreground">Where our graduates build their careers</h2>
    </div>

    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {stories.map((s) => (
        <figure class="rounded-2xl bg-card border-l-4 border-l-brand border border-border p-8">
          <blockquote class="text-base text-foreground leading-relaxed italic">“{s.quote}”</blockquote>
          <figcaption class="mt-6">
            <div class="font-bold text-foreground">{s.name}</div>
            <div class="text-xs text-muted-foreground mt-0.5">{s.role} · <span class="font-bold text-brand">{s.company}</span></div>
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-20 rounded-[32px] bg-brand text-primary-foreground p-8 sm:p-12 md:p-14 flex flex-wrap items-center justify-between gap-6">
      <div>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight">Your career starts with one conversation.</h2>
        <p class="mt-2 text-base opacity-90">Talk to a counsellor about your goals, current skill levels, and placement target timelines.</p>
      </div>
      <a
        href="/contact"
        class="inline-flex h-12 items-center rounded-2xl bg-background px-8 text-sm font-bold text-foreground transition hover:opacity-95"
      >
        Talk To A Placement Advisor
      </a>
    </div>
  </div>
</BaseLayout>
