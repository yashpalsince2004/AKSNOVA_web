---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CareerApplicationForm from '@/components/career/CareerApplicationForm.astro';
import { withBase } from '@/lib/paths';

// Add verified roles here when AKSNOVA has openings to publish.
const openings: {
  title: string;
  team: string;
  location: string;
  type: string;
  summary: string;
  responsibilities: string[];
  qualifications: string[];
  applyHref: string;
}[] = [];
---

<BaseLayout
  title="Careers at AKSNOVA | Open Positions"
  description="Explore job openings at AKSNOVA Edutech and learn about the roles, responsibilities, and qualifications for joining our team."
  canonical="/career"
  showConnectForm={false}
>
  <div class="mx-auto max-w-7xl px-4 py-8 md:px-6">
    <Breadcrumbs items={[{ name: 'Careers', url: '/career' }]} />

    <header class="mt-8 border-b border-border pb-16">
      <p class="eyebrow rise">Careers at AKSNOVA</p>
      <h1 class="rise mt-4 max-w-4xl text-4xl font-extrabold leading-[1.05] tracking-tight text-foreground sm:text-5xl md:text-7xl">
        Help people build what comes next.
      </h1>
      <p class="rise mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
        Join the team working across education, technology, mentorship, and learner support. Browse our current openings and review each role's responsibilities and qualifications.
      </p>
    </header>

    <section aria-labelledby="openings-heading" class="py-16 md:py-20">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <p class="eyebrow">Join our team</p>
          <h2 id="openings-heading" class="mt-2 text-3xl font-bold tracking-tight text-foreground sm:text-4xl">Current openings</h2>
        </div>
        <p class="text-sm text-muted-foreground">{openings.length} {openings.length === 1 ? 'role' : 'roles'} listed</p>
      </div>

      {openings.length > 0 ? (
        <div class="mt-10 space-y-6">
          {openings.map((opening) => (
            <article class="rounded-3xl border border-border bg-card p-6 sm:p-8">
              <header class="border-b border-border pb-6">
                <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
                  <div>
                    <h3 class="text-2xl font-bold text-foreground">{opening.title}</h3>
                    <p class="mt-2 text-sm font-semibold text-brand">{opening.team}</p>
                  </div>
                  <div class="flex flex-wrap gap-2 text-xs font-semibold text-muted-foreground">
                    <span class="rounded-full bg-secondary px-3 py-1.5">{opening.location}</span>
                    <span class="rounded-full bg-secondary px-3 py-1.5">{opening.type}</span>
                  </div>
                </div>
                <p class="mt-5 max-w-3xl text-sm leading-relaxed text-muted-foreground">{opening.summary}</p>
              </header>

              <div class="grid gap-8 pt-6 md:grid-cols-2">
                <div>
                  <h4 class="text-sm font-bold text-foreground">What you'll do</h4>
                  <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted-foreground">
                    {opening.responsibilities.map((item) => (
                      <li class="flex items-start gap-2">
                        <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
                <div>
                  <h4 class="text-sm font-bold text-foreground">What we're looking for</h4>
                  <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted-foreground">
                    {opening.qualifications.map((item) => (
                      <li class="flex items-start gap-2">
                        <span aria-hidden="true" class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-brand"></span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="mt-7 border-t border-border pt-5">
                <a href={withBase(opening.applyHref)} class="inline-flex h-11 items-center rounded-2xl bg-brand px-5 text-sm font-bold text-primary-foreground transition hover:bg-brand-deep">
                  Apply for this role
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-10 rounded-3xl border border-border bg-card p-8 sm:p-12">
          <p class="text-xs font-semibold text-brand">No listed vacancies</p>
          <h3 class="mt-3 text-2xl font-bold tracking-tight text-foreground">There are no open roles posted right now.</h3>
          <p class="mt-3 max-w-2xl leading-relaxed text-muted-foreground">
            Please check back for future opportunities. For general enquiries, contact the AKSNOVA team and include “Careers” in your message.
          </p>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <a href="#career-apply" class="inline-flex h-11 items-center gap-2 rounded-2xl bg-brand px-5 text-sm font-semibold text-primary-foreground transition hover:bg-brand-deep">
              Apply with talent form
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>
            <a href={withBase('/contact')} class="inline-flex h-11 items-center rounded-2xl border border-border bg-background px-5 text-sm font-semibold text-foreground transition hover:bg-secondary">
              Contact AKSNOVA
            </a>
          </div>
        </div>
      )}
    </section>

    <!-- Career Application Form & Direct AKSNOVA Contacts -->
    <CareerApplicationForm />

    <section class="mb-8 rounded-[32px] bg-secondary/50 p-8 sm:p-10">
      <div class="max-w-3xl">
        <p class="eyebrow">Our work</p>
        <h2 class="mt-2 text-2xl font-bold tracking-tight text-foreground sm:text-3xl">A team focused on practical learning</h2>
        <p class="mt-3 leading-relaxed text-muted-foreground">
          AKSNOVA brings together educators and industry practitioners to help learners build useful skills through hands-on training, mentorship, and placement support.
        </p>
        <a href={withBase('/about')} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:underline">
          <span>Learn about AKSNOVA</span>
        </a>
      </div>
    </section>
  </div>
</BaseLayout>
