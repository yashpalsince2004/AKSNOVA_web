---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/home/Hero.astro';
import Stats from '@/components/home/Stats.astro';
import CourseCard from '@/components/courses/CourseCard.astro';
import CourseFilter from '@/components/courses/CourseFilter.tsx';
import CareerJourney from '@/components/home/CareerJourney.astro';
import PlacementNetwork from '@/components/home/PlacementNetwork.astro';
import StudentStories from '@/components/home/StudentStories.astro';
import Faq from '@/components/home/Faq.astro';
import ContactStrip from '@/components/home/ContactStrip.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import { getCollection } from 'astro:content';
import { generateOrganizationSchema } from '@/lib/seo';

// Fetch courses and blogs
const allCourses = await getCollection('courses');
const featuredCourses = allCourses.filter((c) => c.data.featured).slice(0, 6);

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featuredPost = publishedPosts.find((p) => p.data.featured) || publishedPosts[0];
const recentPosts = publishedPosts.filter((p) => p.id !== featuredPost?.id).slice(0, 4);

const orgSchema = generateOrganizationSchema();
---

<BaseLayout
  title="AKSNOVA Edutech | Career-Focused IT & Professional Training"
  description="Career-focused IT and professional training institute offering real projects, certification, internships, and placement assistance with 250+ hiring partners."
  canonical="/"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(orgSchema)} />

  <Hero />
  <Stats />

  <!-- Course Programs Section -->
  <section id="courses" class="mx-auto max-w-7xl px-4 py-16 md:px-6">
    <CourseFilter client:visible />

    <div class="mt-12 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Featured Programs</p>
        <h3 class="mt-2 text-2xl font-bold tracking-tight md:text-3xl text-foreground">
          Top In-Demand Career Tracks
        </h3>
      </div>
      <a
        href="/courses"
        class="inline-flex items-center gap-1.5 text-sm font-bold text-brand hover:underline"
      >
        View all programs
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {featuredCourses.map((c, i) => (
        <CourseCard
          title={c.data.title}
          slug={c.id.replace(/\.(md|mdx)$/, '')}
          category={c.data.category}
          duration={c.data.duration}
          mode={c.data.mode}
          tags={c.data.tags}
          heroImage={c.data.heroImage}
          index={i}
        />
      ))}
    </div>
  </section>

  <CareerJourney />
  <PlacementNetwork />
  <StudentStories />

  <!-- Blog / Insights Section -->
  <section id="insights" class="mx-auto max-w-7xl px-4 py-16 md:px-6">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow">AKSNOVA Insights</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight md:text-4xl text-foreground">
          Learn. Explore. Grow.
        </h2>
        <p class="mt-3 text-muted-foreground">
          Practical career guides, technology roadmaps, and industry advice to help you build skills that matter.
        </p>
      </div>
      <a
        href="/blog"
        class="inline-flex h-11 items-center gap-2 rounded-2xl bg-secondary px-5 text-sm font-bold text-foreground transition hover:bg-accent"
      >
        Explore all insights
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>

    <div class="mt-10 grid gap-4 lg:grid-cols-2">
      {featuredPost && (
        <BlogCard
          slug={featuredPost.id.replace(/\.(md|mdx)$/, '')}
          title={featuredPost.data.title}
          excerpt={featuredPost.data.description}
          category={featuredPost.data.category}
          heroImage={featuredPost.data.heroImage}
          readingTime={featuredPost.data.readingTime}
          tag={featuredPost.data.tags[0]}
          large={true}
        />
      )}

      <div class="grid gap-4 sm:grid-cols-2">
        {recentPosts.map((p) => (
          <BlogCard
            slug={p.id.replace(/\.(md|mdx)$/, '')}
            title={p.data.title}
            excerpt={p.data.description}
            category={p.data.category}
            heroImage={p.data.heroImage}
            readingTime={p.data.readingTime}
            tag={p.data.tags[0]}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- Counselling Band -->
  <section class="mx-auto max-w-7xl px-4 py-8 md:px-6">
    <div class="flex flex-wrap items-center justify-between gap-6 rounded-[32px] bg-card border border-border p-8 sm:p-12 md:p-14">
      <div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-foreground">
          Not sure which course fits your career goals?
        </h2>
        <p class="mt-2 text-sm sm:text-base text-muted-foreground">
          Our mentors offer 1-on-1 personalized guidance to map your skills to the current hiring market.
        </p>
      </div>
      <a
        href="/contact"
        class="inline-flex h-12 items-center rounded-2xl bg-brand px-6 text-sm font-bold text-primary-foreground shadow-md transition hover:bg-brand-deep"
      >
        Talk to a counsellor
      </a>
    </div>
  </section>

  <Faq />
  <ContactStrip />
</BaseLayout>
