---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CourseCard from '@/components/courses/CourseCard.astro';
import { getCollection } from 'astro:content';

const allCourses = await getCollection('courses');
const itCourses = allCourses.filter((c) => c.data.category === 'IT');
const nonItCourses = allCourses.filter((c) => c.data.category === 'NON-IT');
---

<BaseLayout
  title="Career Courses & Professional Programs | AKSNOVA Edutech"
  description="Explore job-ready courses in Full Stack Web Development, Data Science, AI, Cloud DevOps, Cyber Security, Tally Prime, GST, and Graphic Design."
  canonical="/courses"
>
  <div class="mx-auto max-w-7xl px-4 py-8 md:px-6">
    <Breadcrumbs items={[{ name: 'Courses', url: '/courses' }]} />

    <header class="mt-6 max-w-3xl">
      <p class="eyebrow">Academic Programs</p>
      <h1 class="mt-3 text-4xl sm:text-5xl font-bold tracking-tight text-foreground">
        Job-Ready IT & Professional Courses
      </h1>
      <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
        Curriculums engineered directly from industry job descriptions. Master practical tools, complete portfolio capstones, and get verified placement assistance.
      </p>
    </header>

    <!-- Quick Navigation Pills -->
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="#it"
        class="inline-flex items-center gap-2 rounded-2xl bg-secondary px-5 py-2.5 text-sm font-bold text-foreground transition hover:bg-accent"
      >
        <span class="h-2 w-2 rounded-full bg-brand"></span>
        IT & Technology Programs ({itCourses.length})
      </a>
      <a
        href="#non-it"
        class="inline-flex items-center gap-2 rounded-2xl bg-secondary px-5 py-2.5 text-sm font-bold text-foreground transition hover:bg-accent"
      >
        <span class="h-2 w-2 rounded-full bg-brand"></span>
        Non-IT & Professional Skills ({nonItCourses.length})
      </a>
    </div>

    <!-- IT Programs Section -->
    <section id="it" class="mt-16 scroll-mt-24">
      <div class="flex items-center justify-between border-b border-border pb-4">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-foreground">
            IT & Technology Programs
          </h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Software development, data intelligence, cloud architecture, and cyber defense.
          </p>
        </div>
        <span class="text-xs font-bold uppercase tracking-widest text-brand hidden sm:block">
          Classroom + Hybrid
        </span>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {itCourses.map((c, i) => (
          <CourseCard
            title={c.data.title}
            slug={c.id.replace(/\.(md|mdx)$/, '')}
            category={c.data.category}
            duration={c.data.duration}
            mode={c.data.mode}
            tags={c.data.tags}
            heroImage={c.data.heroImage}
            index={i}
          />
        ))}
      </div>
    </section>

    <!-- Non-IT Programs Section -->
    <section id="non-it" class="mt-20 scroll-mt-24">
      <div class="flex items-center justify-between border-b border-border pb-4">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold text-foreground">
            Non-IT & Professional Programs
          </h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Computerized accounting, taxation, graphic visual communications, and office productivity.
          </p>
        </div>
        <span class="text-xs font-bold uppercase tracking-widest text-brand hidden sm:block">
          Practical Workshops
        </span>
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {nonItCourses.map((c, i) => (
          <CourseCard
            title={c.data.title}
            slug={c.id.replace(/\.(md|mdx)$/, '')}
            category={c.data.category}
            duration={c.data.duration}
            mode={c.data.mode}
            tags={c.data.tags}
            heroImage={c.data.heroImage}
            index={i}
          />
        ))}
      </div>
    </section>

    <!-- Bottom Guidance Banner -->
    <div class="mt-20 rounded-[32px] bg-card border border-border p-8 sm:p-12 md:p-14 text-center">
      <h3 class="text-2xl sm:text-3xl font-bold text-foreground">
        Need assistance selecting the right course?
      </h3>
      <p class="mx-auto mt-3 max-w-xl text-muted-foreground text-sm sm:text-base">
        Book a free 20-minute profile evaluation. We will review your background and recommend the highest-ROI program for you.
      </p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a
          href="/contact"
          class="inline-flex h-12 items-center rounded-2xl bg-brand px-6 text-sm font-bold text-primary-foreground shadow-md transition hover:bg-brand-deep"
        >
          Book Free Career Counselling
        </a>
        <a
          href="/resume-builder"
          class="inline-flex h-12 items-center rounded-2xl bg-secondary px-6 text-sm font-bold text-foreground transition hover:bg-accent"
        >
          Check Placement Readiness
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
