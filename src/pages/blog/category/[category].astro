---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import CategoryChip from '@/components/blog/CategoryChip.astro';
import { getCollection } from 'astro:content';
import { BLOG_CATEGORIES, slugifyCategory } from '@/lib/blog-categories';
import { withBase } from '@/lib/paths';

export async function getStaticPaths() {
  return BLOG_CATEGORIES.map((cat) => ({
    params: { category: slugifyCategory(cat) },
    props: { categoryName: cat },
  }));
}

const { categoryName } = Astro.props;
const currentCategorySlug = Astro.params.category;

const allPosts = await getCollection('blog');
const categoryPosts = allPosts
  .filter((p) => !p.data.draft && p.data.category.toLowerCase() === categoryName.toLowerCase())
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout
  title={`${categoryName} Articles & Guides | AKSNOVA Insights`}
  description={`Browse comprehensive guides, career roadmaps, and tutorials on ${categoryName} from AKSNOVA Edutech.`}
  canonical={`/blog/category/${currentCategorySlug}`}
>
  <div class="mx-auto max-w-7xl px-4 py-8 md:px-6">
    <Breadcrumbs
      items={[
        { name: 'Insights', url: '/blog' },
        { name: categoryName, url: `/blog/category/${currentCategorySlug}` },
      ]}
    />

    <header class="mt-6 max-w-3xl">
      <span class="eyebrow">Category Archive</span>
      <h1 class="mt-3 text-4xl sm:text-5xl font-semibold tracking-tight text-foreground">
        {categoryName}
      </h1>
      <p class="mt-3 text-muted-foreground">
        Explore actionable articles, tools, and career roadmaps related to {categoryName}.
      </p>
    </header>

    <!-- Category selector pills -->
    <div class="mt-8 flex flex-wrap gap-2">
      {BLOG_CATEGORIES.map((c) => (
        <CategoryChip category={c} active={c === categoryName} />
      ))}
    </div>

    <!-- Posts list -->
    {categoryPosts.length > 0 ? (
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {categoryPosts.map((p) => (
          <BlogCard
            slug={p.id.replace(/\.(md|mdx)$/, '')}
            title={p.data.title}
            excerpt={p.data.description}
            category={p.data.category}
            heroImage={p.data.heroImage}
            readingTime={p.data.readingTime}
            tag={p.data.tags[0]}
          />
        ))}
      </div>
    ) : (
      <div class="mt-12 rounded-[28px] bg-card border border-border p-12 text-center max-w-xl mx-auto">
        <h2 class="text-xl font-bold text-foreground">New Articles Coming Soon</h2>
        <p class="mt-2 text-sm text-muted-foreground">
          Our mentors are drafting new practical guides and tutorials for {categoryName}. Check back shortly or browse other categories.
        </p>
        <a
          href={withBase('/blog')}
          class="mt-6 inline-flex h-10 items-center justify-center rounded-xl bg-secondary px-5 text-xs font-bold uppercase tracking-wider text-foreground hover:bg-accent transition"
        >
          View All Insights
        </a>
      </div>
    )}
  </div>
</BaseLayout>
