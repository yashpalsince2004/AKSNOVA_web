---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import CategoryChip from '@/components/blog/CategoryChip.astro';
import { getCollection } from 'astro:content';
import { BLOG_CATEGORIES } from '@/lib/blog-categories';
import { withBase } from '@/lib/paths';

const allPosts = await getCollection('blog');
const publishedPosts = allPosts
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());

const featuredPost = publishedPosts.find((p) => p.data.featured) || publishedPosts[0];
const otherPosts = publishedPosts.filter((p) => p.id !== featuredPost?.id);
---

<BaseLayout
  title="AKSNOVA Insights | Career & Technology Guides"
  description="Practical guides, technology roadmaps, and career advice on Artificial Intelligence, Data Science, Python, Full Stack, Cloud, and Placements."
  canonical="/blog"
>
  <div class="mx-auto max-w-7xl px-4 py-8 md:px-6">
    <Breadcrumbs items={[{ name: 'Insights', url: '/blog' }]} />

    <header class="mt-6 max-w-3xl">
      <div class="flex items-center gap-3">
        <span class="eyebrow">AKSNOVA Insights</span>
        <a
          href={withBase('/rss.xml')}
          aria-label="RSS Feed"
          class="inline-flex items-center gap-1 rounded-full bg-secondary px-2.5 py-0.5 text-[11px] font-bold text-muted-foreground hover:text-foreground transition"
        >
          <svg class="h-3 w-3 text-brand" fill="currentColor" viewBox="0 0 24 24">
            <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20 5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93v-2.83Z"/>
          </svg>
          RSS
        </a>
      </div>
      <h1 class="rise mt-3 text-4xl sm:text-5xl md:text-6xl font-semibold tracking-[-1.2px] text-foreground leading-[1.1]">
        Learn something today. Build your career tomorrow.
      </h1>
      <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
        Step-by-step career blueprints, coding tutorials, and hiring market strategies written by practicing engineers.
      </p>
    </header>

    <!-- Categories Filter Strip -->
    <div class="mt-8 flex flex-wrap gap-2">
      {BLOG_CATEGORIES.map((cat) => (
        <CategoryChip category={cat} />
      ))}
    </div>

    <!-- Featured Hero Post -->
    {featuredPost && (
      <div class="mt-12">
        <BlogCard
          slug={featuredPost.id.replace(/\.(md|mdx)$/, '')}
          title={featuredPost.data.title}
          excerpt={featuredPost.data.description}
          category={featuredPost.data.category}
          heroImage={featuredPost.data.heroImage}
          readingTime={featuredPost.data.readingTime}
          tag={featuredPost.data.tags[0]}
          large={true}
        />
      </div>
    )}

    <!-- Posts Grid -->
    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {otherPosts.map((post) => (
        <BlogCard
          slug={post.id.replace(/\.(md|mdx)$/, '')}
          title={post.data.title}
          excerpt={post.data.description}
          category={post.data.category}
          heroImage={post.data.heroImage}
          readingTime={post.data.readingTime}
          tag={post.data.tags[0]}
        />
      ))}
    </div>
  </div>
</BaseLayout>
