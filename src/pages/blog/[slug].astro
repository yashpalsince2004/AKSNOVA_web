---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import ShareButtons from '@/components/blog/ShareButtons.tsx';
import { getCollection, render } from 'astro:content';
import { generateArticleSchema } from '@/lib/seo';
import { slugifyCategory } from '@/lib/blog-categories';
import { withBase } from '@/lib/paths';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const slug = post.id.replace(/\.(md|mdx)$/, '');
const articleUrl = `/blog/${slug}`;

// Format dates
const formattedPubDate = post.data.pubDate.toLocaleDateString('en-IN', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const formattedUpdateDate = post.data.updatedDate
  ? post.data.updatedDate.toLocaleDateString('en-IN', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : null;

// Filter table of contents for h2 and h3
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Related articles
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id && (p.data.category === post.data.category || post.data.relatedPosts.includes(p.id.replace(/\.(md|mdx)$/, ''))))
  .slice(0, 3);

// Related course link if specified
const allCourses = await getCollection('courses');
const relatedCourse = allCourses.find((c) =>
  post.data.relatedCourses.some((rc) => c.data.title.toLowerCase().includes(rc.toLowerCase()))
);

// Schema
const articleSchema = generateArticleSchema({
  title: post.data.title,
  description: post.data.description,
  url: articleUrl,
  publishedTime: post.data.pubDate.toISOString(),
  modifiedTime: post.data.updatedDate?.toISOString(),
  author: post.data.author,
  image: post.data.heroImage,
  category: post.data.category,
});
---

<BaseLayout
  title={post.data.seoTitle || `${post.data.title} | AKSNOVA Insights`}
  description={post.data.seoDescription || post.data.description}
  canonical={articleUrl}
  ogImage={post.data.heroImage}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
  modifiedTime={post.data.updatedDate?.toISOString()}
  author={post.data.author}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleSchema)} />

  <div class="mx-auto max-w-7xl px-4 py-8 md:px-6">
    <Breadcrumbs
      items={[
        { name: 'Insights', url: '/blog' },
        { name: post.data.category, url: `/blog/category/${slugifyCategory(post.data.category)}` },
        { name: post.data.title, url: articleUrl },
      ]}
    />

    <!-- Article Header -->
    <header class="mt-8 max-w-4xl">
      <a
        href={`/blog/category/${slugifyCategory(post.data.category)}`}
        class="eyebrow uppercase hover:underline"
      >
        {post.data.category}
      </a>

      <h1 class="mt-3 text-3xl sm:text-4xl md:text-5xl font-semibold leading-[1.1] tracking-[-1px] text-foreground">
        {post.data.title}
      </h1>

      <p class="mt-4 max-w-2xl text-lg text-muted-foreground leading-relaxed">
        {post.data.description}
      </p>

      <!-- Meta Bar & Share Buttons -->
      <div class="mt-6 flex flex-wrap items-center justify-between gap-4 border-y border-border py-4 text-xs sm:text-sm">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-muted-foreground">
          <span class="font-bold text-foreground">By {post.data.author}</span>
          <span>·</span>
          <span>Published {formattedPubDate}</span>
          {formattedUpdateDate && <span>(Updated {formattedUpdateDate})</span>}
          <span>·</span>
          <span>{post.data.readingTime} min read</span>
        </div>

        <ShareButtons client:idle title={post.data.title} url={`https://aksnova.in${articleUrl}`} />
      </div>
    </header>

    <!-- Cover Image -->
    <div class="mt-8 overflow-hidden rounded-[32px] border border-border shadow-xl">
      <img
        src={post.data.heroImage}
        alt={post.data.title}
        width="1200"
        height="630"
        loading="eager"
        class="h-[280px] sm:h-[460px] w-full object-cover"
      />
    </div>

    <!-- Article Main Grid -->
    <div class="mt-12 grid gap-12 lg:grid-cols-[260px_1fr]">
      <!-- Sticky Table of Contents -->
      {toc.length > 0 && (
        <aside class="order-2 lg:order-1">
          <div class="sticky top-28 rounded-2xl bg-card border border-border p-5">
            <h2 class="text-xs font-bold uppercase tracking-widest text-brand mb-3">
              On this page
            </h2>
            <nav aria-label="Table of contents">
              <ol class="space-y-2 text-xs sm:text-sm">
                {toc.map((item, idx) => (
                  <li class={item.depth === 3 ? 'pl-3' : ''}>
                    <a
                      href={`#${item.slug}`}
                      class="flex items-start gap-2 text-muted-foreground transition hover:text-foreground hover:underline"
                    >
                      {item.depth === 2 && (
                        <span class="font-bold text-brand shrink-0">
                          {String(idx + 1).padStart(2, '0')}
                        </span>
                      )}
                      <span class="line-clamp-2">{item.text}</span>
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </div>
        </aside>
      )}

      <!-- Body Content -->
      <article class="order-1 lg:order-2 max-w-[760px] text-foreground text-[17px] leading-[1.8] prose-styles">
        <Content />

        <!-- Related Course Card CTA -->
        {relatedCourse && (
          <div class="mt-14 rounded-[28px] bg-card border border-brand/40 p-8 shadow-sm">
            <p class="eyebrow">Related AKSNOVA Program</p>
            <h2 class="mt-2 text-2xl font-bold text-foreground">
              {relatedCourse.data.title}
            </h2>
            <p class="mt-2 text-sm text-muted-foreground leading-relaxed">
              {relatedCourse.data.description}
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a
                href={withBase(`/courses/${relatedCourse.id.replace(/\.(md|mdx)$/, '')}`)}
                class="inline-flex h-11 items-center gap-2 rounded-2xl bg-brand px-5 text-sm font-bold text-primary-foreground shadow transition hover:bg-brand-deep"
              >
                View Full Curriculum
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
              <a
                href={withBase('/contact')}
                class="inline-flex h-11 items-center rounded-2xl bg-secondary px-5 text-sm font-bold text-foreground transition hover:bg-accent"
              >
                Book Free Counselling
              </a>
            </div>
          </div>
        )}

        <!-- Dual Guidance Blocks -->
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          <div class="rounded-2xl bg-card border border-border p-6">
            <h3 class="font-bold text-foreground">Not sure where to begin?</h3>
            <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">
              Our academic advisors provide free profile roadmaps based on your background.
            </p>
            <a
              href={withBase('/contact')}
              class="mt-4 inline-flex rounded-xl bg-foreground px-4 py-2 text-xs font-bold text-background transition hover:opacity-90"
            >
              Book Free Counselling
            </a>
          </div>

          <div class="rounded-2xl bg-card border border-border p-6">
            <h3 class="font-bold text-foreground">Build a verified tech resume</h3>
            <p class="mt-1.5 text-xs text-muted-foreground leading-relaxed">
              Upload your current resume and let our builder tailor it for hiring partners.
            </p>
            <a
              href={withBase('/resume-builder')}
              class="mt-4 inline-flex rounded-xl bg-secondary px-4 py-2 text-xs font-bold text-foreground transition hover:bg-accent"
            >
              Try Resume Builder
            </a>
          </div>
        </div>
      </article>
    </div>

    <!-- Related Articles Grid -->
    {relatedPosts.length > 0 && (
      <section class="mt-20 border-t border-border pt-12">
        <h2 class="text-2xl font-bold text-foreground">Related Articles & Roadmaps</h2>
        <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {relatedPosts.map((r) => (
            <BlogCard
              slug={r.id.replace(/\.(md|mdx)$/, '')}
              title={r.data.title}
              excerpt={r.data.description}
              category={r.data.category}
              heroImage={r.data.heroImage}
              readingTime={r.data.readingTime}
              tag={r.data.tags[0]}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style is:global>
  /* Markdown content typography styling */
  .prose-styles h2 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    scroll-margin-top: 6rem;
  }
  .prose-styles h3 {
    font-size: 1.35rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
    scroll-margin-top: 6rem;
  }
  .prose-styles p {
    margin-bottom: 1.25rem;
    color: var(--color-foreground);
    opacity: 0.9;
  }
  .prose-styles ul {
    list-style-type: disc;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .prose-styles ol {
    list-style-type: decimal;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }
  .prose-styles li {
    margin-bottom: 0.5rem;
  }
  .prose-styles blockquote {
    border-left: 4px solid var(--color-brand);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    background-color: var(--color-card);
    border-radius: 0 1rem 1rem 0;
    font-style: italic;
  }
  .prose-styles pre {
    border-radius: 1rem;
    padding: 1rem 1.25rem;
    margin: 1.5rem 0;
    overflow-x: auto;
    background-color: var(--color-card);
    border: 1px solid var(--color-border);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .prose-styles table {
    width: 100%;
    margin: 1.5rem 0;
    border-collapse: collapse;
    font-size: 0.875rem;
    overflow-x: auto;
    display: block;
  }
  .prose-styles th, .prose-styles td {
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
  }
  .prose-styles th {
    background-color: var(--color-secondary);
    font-weight: 700;
  }
</style>
